---
interface Props {
  bgImg?: string;
  bookImg?: string;
}
const {
  bgImg = "https://www.figma.com/api/mcp/asset/1583e843-2525-49b5-8a8d-87ea3c2c4894.png",
  bookImg = "https://www.figma.com/api/mcp/asset/c692adf8-79d8-4ae6-a651-ff756ca126c7.png",
} = Astro.props;
const bg = bgImg;
---

<!-- Outer wrapper: clips nothing — lets book overflow above -->
<div class="relative">
  <section class="relative min-h-[280px] sm:min-h-[320px] md:h-[360px]">
    <!-- Background image + overlay, clipped to section only -->
    <div class="absolute inset-0 overflow-hidden">
      <img
        src={bg}
        alt=""
        class="w-full h-full object-cover pointer-events-none"
      />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6">
      <div
        class="flex items-center min-h-[280px] sm:min-h-[320px] md:min-h-[360px]"
      >
        <!-- Left: book image — overflows above via negative margin-top -->
        <div class="hidden md:block w-2/5 lg:w-[38%] flex-shrink-0">
          <div class="relative -mt-16 sm:-mt-20 lg:-mt-15 pb-0">
            <img
              src={bookImg}
              alt="Book"
              class="w-full max-w-[320px] lg:max-w-[400px] object-contain object-bottom drop-shadow-2xl"
            />
          </div>
        </div>

        <!-- Right: text content -->
        <div
          class="flex flex-col justify-center py-10 sm:py-0 md:pl-8 lg:pl-12 w-full md:w-3/5 lg:w-[62%]"
        >
          <h2
            class="text-white font-bold text-xl sm:text-2xl uppercase leading-snug mb-3 sm:mb-4"
          >
            Do You Have Concerns?
          </h2>
          <p
            class="text-white text-xs sm:text-sm font-semibold leading-relaxed mb-6 sm:mb-7 max-w-md"
          >
            Lorem Ipsum is simply dummy text of the printing and typesetting
            industry. Lorem Ipsum has been the industry's standard dummy text
            ever since 1966 when designers at Letraset and James Mosley.
          </p>
          <div>
            <a
              href="/contact"
              class="inline-block bg-white h-10 px-5 sm:px-6 leading-10 text-black font-semibold text-sm hover:bg-[#3075ba] hover:text-white transition-colors"
            >
              Speak to our Consultant
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
