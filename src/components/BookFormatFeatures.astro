---
const checkIcon = "/images/82c01109-236c-45ff-995a-8ea53d80f311.svg";

const bullets = [
  "Custom trim sizes and margin settings for print and digital editions",
  "Professional chapter headers, footers, and page numbering",
  "Consistent font pairing and typographic hierarchy throughout",
  "Front matter and back matter layout including TOC and index",
  "Platform-ready exports for KDP, IngramSpark, and major ebook stores",
];

const featureCards = [
  {
    icon: "/images/871f081f-72a5-4b86-8912-ef3860b1bcb5.svg",
    title: "Print & Hardcover Formatting",
  },
  {
    icon: "/images/d594e056-6435-4cab-98c2-22fdf0ff1c4b.svg",
    title: "Ebook & Digital Layout",
  },
  {
    icon: "/images/3fe3aca4-cdb5-444b-bfe2-49cfc723c4c4.svg",
    title: "Print-on-Demand Ready Files",
  },
  {
    icon: "/images/c3e1af2b-f81c-4f6e-b5ad-f2bc1d4d4959.svg",
    title: "ISBN & Barcode Integration",
  },
];
import ScrollReveal from "./ui/ScrollReveal.tsx";
---

<section class="py-10 sm:py-12 bg-white">
  <ScrollReveal client:visible direction="up" className="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-start">

      <!-- Left: title + checklist -->
      <div>
        <h2 class="font-bold text-xl sm:text-2xl uppercase leading-snug text-black mb-3 sm:mb-4">
          Expert Book Formatting Made Simple.
        </h2>
        <p class="text-[#555] text-xs sm:text-sm leading-relaxed mb-5 sm:mb-6">
          We take the complexity out of book formatting so your manuscript goes
          from raw draft to shelf-ready masterpiece without the headache.
        </p>
        <ul class="space-y-3">
          {bullets.map((b) => (
            <li class="flex items-start gap-3">
              <img src={checkIcon} alt="" class="w-4 h-4 mt-0.5 flex-shrink-0" />
              <span class="text-[#555] text-xs sm:text-sm leading-relaxed">{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: 2×2 feature cards -->
      <div class="grid grid-cols-2 gap-3 sm:gap-4">
        {featureCards.map((card) => (
          <div class="bg-[rgba(217,217,217,0.1)] rounded-xl p-4 sm:p-5">
            <div class="bg-[rgba(217,217,217,0.5)] w-12 h-12 sm:w-14 sm:h-14 rounded-lg flex items-center justify-center mb-3">
              <img src={card.icon} alt="" class="w-7 h-7 sm:w-8 sm:h-8" />
            </div>
            <p class="font-semibold text-xs sm:text-sm text-black capitalize leading-snug">
              {card.title}
            </p>
          </div>
        ))}
      </div>

    </div>
  </ScrollReveal>
</section>
