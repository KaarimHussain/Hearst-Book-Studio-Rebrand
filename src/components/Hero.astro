---
const heroBg = "https://www.figma.com/api/mcp/asset/de8d7010-87ab-41c5-9960-37e9fef4ad29.png";
const playCircle = "https://www.figma.com/api/mcp/asset/bc11f2c6-b940-459e-93a5-714f5e32413d.svg";
const playIcon = "https://www.figma.com/api/mcp/asset/f8f44729-e495-4ea4-ad86-1f506eb92c1a.svg";
---

<section class="relative w-full min-h-screen flex items-end overflow-hidden">
  <img
    src={heroBg}
    alt=""
    class="absolute inset-0 w-full h-full object-cover pointer-events-none"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-black/65"></div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 pb-12 sm:pb-16 pt-24 sm:pt-28">
    <h1 class="text-white font-bold text-3xl sm:text-4xl lg:text-5xl leading-tight uppercase mb-4">
      DO YOU HAVE A<br />
      MANUSCRIPT READY TO<br />
      BE PUBLISHED?
    </h1>

    <p class="text-white font-medium text-sm sm:text-base leading-relaxed mb-6 max-w-xs sm:max-w-md lg:max-w-xl">
      Hearst Book Publishing has made it much easier to self-publish a book,
      with hands-on support from the first word to the final cover.
    </p>

    <div class="flex items-center gap-1.5">
      <div class="bg-[#3075ba] h-2 w-10 sm:w-12"></div>
      <div class="bg-white h-2 w-7 sm:w-8"></div>
      <div class="bg-white h-2 w-5 sm:w-6"></div>
    </div>
  </div>

  <!-- Play button hidden on small screens -->
  <div class="hidden sm:block absolute right-8 sm:right-16 lg:right-24 bottom-10 sm:bottom-14 z-10">
    <div class="relative w-12 h-12 sm:w-14 sm:h-14">
      <img src={playCircle} alt="" class="w-full h-full" />
      <img src={playIcon} alt="Watch video" class="absolute inset-0 m-auto w-6 h-6 sm:w-7 sm:h-7" />
    </div>
  </div>
</section>
