---
const checkIcon = "https://www.figma.com/api/mcp/asset/47db2b33-bb72-41f0-aed2-118a3bc84b6f.svg";

const bullets = [
  "Complete end to end book publishing support for authors",
  "Expert editing and innovative formatting for print & digital",
  "Breathtaking cover design and professional polishing",
  "Proven marketing tactics to reach your target readers",
  "Bespoke printing and global distribution strategies",
];

const featureCards = [
  {
    icon: "https://www.figma.com/api/mcp/asset/bfb82319-2e4b-4a49-a76b-f7c1807fb94b.svg",
    title: "Several Hardbound Copies of Your Book",
  },
  {
    icon: "https://www.figma.com/api/mcp/asset/687b4f34-fbcc-48f8-a2fe-a1e4c8271c4e.svg",
    title: "Converting and Distributing Ebooks",
  },
  {
    icon: "https://www.figma.com/api/mcp/asset/d5b36f00-2e01-4fbd-a442-e484099bb8c4.svg",
    title: "Distribution Via Print on Demand",
  },
  {
    icon: "https://www.figma.com/api/mcp/asset/c2eb4e6a-b29f-4061-a20a-ac716f14357b.svg",
    title: "Authorized ISBN and Barcodes",
  },
];
---

<section class="py-10 sm:py-12 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-start">

      <!-- Left: title + checklist -->
      <div>
        <h2 class="font-bold text-xl sm:text-2xl uppercase leading-snug text-black mb-3 sm:mb-4">
          Expert Book Publishing Made Simple.
        </h2>
        <p class="text-[#555] text-xs sm:text-sm leading-relaxed mb-5 sm:mb-6">
          Lorem Ipsum is simply dummy text of the printing and typesetting
          industry has been the industry's standard dummy text.
        </p>
        <ul class="space-y-3">
          {bullets.map((b) => (
            <li class="flex items-start gap-3">
              <img src={checkIcon} alt="" class="w-4 h-4 mt-0.5 flex-shrink-0" />
              <span class="text-[#555] text-xs sm:text-sm leading-relaxed">{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: 2×2 feature cards -->
      <div class="grid grid-cols-2 gap-3 sm:gap-4">
        {featureCards.map((card) => (
          <div class="bg-[rgba(217,217,217,0.1)] rounded-xl p-4 sm:p-5">
            <div class="bg-[rgba(217,217,217,0.5)] w-12 h-12 sm:w-14 sm:h-14 rounded-lg flex items-center justify-center mb-3">
              <img src={card.icon} alt="" class="w-7 h-7 sm:w-8 sm:h-8" />
            </div>
            <p class="font-semibold text-xs sm:text-sm text-black capitalize leading-snug">
              {card.title}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
