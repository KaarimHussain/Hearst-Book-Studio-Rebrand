---
const photo = "/images/353dc79b-ae86-4917-a2be-0eca8ae63696.webp";
import ScrollReveal from "./ui/ScrollReveal.tsx";
---

<section class="py-20 overflow-hidden">
  <ScrollReveal client:visible direction="up" className="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 items-stretch">

    <!-- Left: photo -->
    <div class="h-64 sm:h-80 md:h-auto min-h-0 order-1">
      <img
        src={photo}
        alt="Audio Book"
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Right: text -->
    <div class="bg-[rgba(217,217,217,0.1)] flex flex-col justify-center px-6 sm:px-8 md:px-10 py-10 sm:py-12 order-2">
      <h2 class="font-bold text-xl sm:text-2xl uppercase leading-snug text-black mb-3 sm:mb-4">
        HEARST Book Studio A Leading Audio Book Production Company
      </h2>
      <p class="text-[#555] text-sm leading-relaxed mb-4">
        At HearEst Book Studio, we bring your words to life through the power of
        professional audio. Our audio book production service pairs your manuscript
        with skilled narrators, studio-quality recording, and expert sound
        engineering to create an immersive listening experience your audience will
        never forget.
      </p>
      <p class="text-[#555] text-sm leading-relaxed">
        From narrator casting and studio session management to mastering and
        platform delivery, we handle the entire audio production pipeline. Whether
        you're releasing your first audio title or expanding an existing catalogue,
        our team ensures your audio book meets the technical standards of every
        major platform — including Audible, Apple Books, and Spotify.
      </p>
    </div>
  </ScrollReveal>
</section>

<ScrollReveal client:visible direction="up" className="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
  <p class="text-[#555] text-xs sm:text-sm leading-relaxed text-center">
    Audio books are one of the fastest-growing formats in publishing, and HearEst Book Studio gives you
    everything you need to compete in this exciting space. We match each manuscript with a narrator whose
    voice and style perfectly complement the writing, record in professional sound-treated studios, and
    deliver broadcast-quality masters ready for immediate upload. Our team also manages all metadata,
    chapter markers, and platform submissions so your audio book is discoverable from day one.
  </p>
</ScrollReveal>
