---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import InnerPageHero from "../../components/InnerPageHero.astro";
import BookPublishingIntro from "../../components/BookPublishingIntro.astro";
import BookPublishingFeatures from "../../components/BookPublishingFeatures.astro";
import HowWeWork from "../../components/HowWeWork.astro";
import WhyChooseUs from "../../components/WhyChooseUs.astro";
import EverythingSection from "../../components/EverythingSection.tsx";
import Footer from "../../components/Footer.astro";
---

<Layout title="Book Publishing — HearEst Book Studio">
  <div class="relative">
    <Navbar client:load />
    <InnerPageHero
      bgImg="/images/14b1ebf3-46ce-49c1-9471-dbb2cd7661b0.webp"
      heading="Bring Your Book to Life with Expert Publishing!"
    />
  </div>

  <BookPublishingIntro />
  <BookPublishingFeatures />
  <HowWeWork />

  <WhyChooseUs
    bgImg="/images/b970ac2b-febd-4171-a7c1-b3f42ba164dc.webp"
    bookImg="/images/56e00cfe-2acd-4daa-8ece-e76cb4d68c7e.webp"
  />

  <EverythingSection client:load />
  <Footer />
</Layout>
