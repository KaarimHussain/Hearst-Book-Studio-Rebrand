---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import EverythingSection from "../../components/EverythingSection.tsx";
import Footer from "../../components/Footer.astro";
---

<Layout title="Book Illustrations — HearEst Book Studio">
  <div class="relative bg-[#0d0015] text-white">
    <Navbar client:load />

    {/* ── HERO ── */}
    <section
      class="relative min-h-[90vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 bg-cover bg-center bg-no-repeat overflow-hidden"
      style="background-image: url('/images/services/illustrations-book/hero-section.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-[#0d0015]/90 via-[#0d0015]/80 to-[#0d0015]/95 pointer-events-none"></div>

      {/* Decorative paint-stroke rings */}
      <div class="absolute top-20 left-8 w-40 h-40 rounded-full border-4 border-fuchsia-500/20 blur-sm pointer-events-none"></div>
      <div class="absolute bottom-24 right-10 w-64 h-64 rounded-full border-4 border-violet-500/15 blur-sm pointer-events-none"></div>
      <div class="absolute top-1/2 left-1/4 w-24 h-24 rounded-full bg-amber-400/10 blur-2xl pointer-events-none"></div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <div class="flex flex-wrap items-center justify-center gap-3 mb-7">
          <span class="bg-fuchsia-600 text-white text-xs font-black uppercase tracking-wider px-4 py-1.5 rounded-full shadow-lg border border-white/20">
            🖌️ Custom Artwork
          </span>
          <span class="bg-amber-400 text-black text-xs font-black uppercase tracking-wider px-4 py-1.5 rounded-full shadow-lg">
            🎨 Every Style & Medium
          </span>
          <span class="bg-cyan-500 text-black text-xs font-black uppercase tracking-wider px-4 py-1.5 rounded-full shadow-lg">
            ✏️ Concept to Final Art
          </span>
        </div>

        <h1 class="text-5xl sm:text-7xl lg:text-8xl font-black uppercase tracking-tight leading-none mb-6 drop-shadow-2xl">
          <span class="text-white">ART THAT</span><br />
          <span
            class="bg-gradient-to-r from-fuchsia-400 via-violet-400 to-cyan-400 bg-clip-text text-transparent"
          >
            SPEAKS LOUDER
          </span><br />
          <span class="text-amber-400 italic">than words.</span>
        </h1>

        <p class="text-base sm:text-lg md:text-xl text-gray-200 font-medium max-w-3xl mx-auto leading-relaxed mb-8 sm:mb-10 drop-shadow-md">
          From watercolor children's books to gritty graphic novel line art —
          our illustrators breathe life into every page, character, and scene
          with breathtaking detail and boundless creativity.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="h-12 px-8 bg-fuchsia-600 hover:bg-fuchsia-500 text-white font-black text-sm uppercase tracking-wider rounded-full transition-all transform hover:scale-105 inline-flex items-center gap-2 shadow-2xl border border-white/20"
          >
            <span>Commission Your Illustrations</span>
          </a>
          <a
            href="/packages"
            class="h-12 px-8 bg-amber-400 hover:bg-amber-300 text-black font-black text-sm uppercase tracking-wider rounded-full transition-all transform hover:scale-105 inline-flex items-center shadow-2xl"
          >
            <span>View Illustration Packages</span>
          </a>
        </div>
      </div>
    </section>

    {/* ── ABOUT / INTRO ── */}
    <section
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-fuchsia-900/40"
      style="background-image: url('/images/services/illustrations-book/about-section.png');"
    >
      <div class="absolute inset-0 bg-[#0d0015]/90 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div>
            <span class="text-xs font-black uppercase tracking-widest text-fuchsia-400 bg-fuchsia-400/10 px-4 py-1.5 rounded-full border border-fuchsia-400/30 inline-block mb-5">
              🖼️ A Studio Where Imagination Has No Limits
            </span>
            <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white leading-tight mb-5">
              HEARST BOOK STUDIO —<br />
              <span class="text-fuchsia-400">WHERE ART MEETS STORY</span>
            </h2>
            <p class="text-sm text-gray-300 leading-relaxed mb-4">
              Great illustrations don't just decorate a book — they define it.
              At HearEst Book Studio our illustration team spans dozens of
              specialisms: lush watercolor spreads for children's picture books,
              razor-sharp ink work for graphic novels, rich digital painting for
              fantasy covers, and minimalist vector art for modern non-fiction.
            </p>
            <p class="text-sm text-gray-300 leading-relaxed mb-6">
              Every project starts with deep collaboration. We study your
              characters, your world, your palette, and your readers — then we
              build a visual language that makes your book impossible to put
              down. From the first pencil sketch to the print-ready CMYK file,
              we own every pixel.
            </p>
            <div class="flex items-center gap-4 text-xs font-bold text-cyan-300 bg-cyan-400/10 p-4 rounded-2xl border border-cyan-400/30">
              <span class="text-2xl">🎭</span>
              <span>30+ illustrators across 10 distinct art styles — all under one roof.</span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            {[
              { icon: "🖌️", label: "Watercolor",      color: "border-pink-500/40 bg-pink-950/30",    tag: "bg-pink-500"    },
              { icon: "✒️", label: "Ink & Line Art",  color: "border-violet-500/40 bg-violet-950/30",tag: "bg-violet-500"  },
              { icon: "💻", label: "Digital Painting", color: "border-cyan-500/40 bg-cyan-950/30",    tag: "bg-cyan-500"    },
              { icon: "📐", label: "Vector Art",       color: "border-amber-500/40 bg-amber-950/30",  tag: "bg-amber-500"   },
              { icon: "🎭", label: "Character Design", color: "border-fuchsia-500/40 bg-fuchsia-950/30", tag: "bg-fuchsia-500" },
              { icon: "🖼️", label: "Cover Art",        color: "border-emerald-500/40 bg-emerald-950/30", tag: "bg-emerald-500" },
            ].map((s) => (
              <div class={`rounded-2xl border-2 p-4 flex items-center gap-3 hover:-translate-y-1 transition-transform duration-300 ${s.color}`}>
                <div class={`w-10 h-10 rounded-xl ${s.tag} flex items-center justify-center text-lg flex-shrink-0`}>
                  {s.icon}
                </div>
                <span class="font-black text-xs text-white uppercase tracking-wide">{s.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ── SERVICES / FEATURES ── */}
    <section
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-fuchsia-900/40"
      style="background-image: url('/images/services/illustrations-book/services-section.png');"
    >
      <div class="absolute inset-0 bg-[#0d0015]/88 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <span class="text-xs font-black uppercase tracking-widest text-amber-400 bg-amber-400/10 px-4 py-1.5 rounded-full border border-amber-400/30 inline-block mb-3">
            EVERY STYLE. EVERY GENRE. EVERY VISION.
          </span>
          <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white drop-shadow-md">
            ILLUSTRATION SERVICES WE OFFER
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
          {/* Checklist */}
          <div class="bg-black/50 border border-white/10 rounded-3xl p-8">
            <h3 class="font-black text-base text-fuchsia-400 uppercase tracking-wider mb-6">Our Full Illustration Suite:</h3>
            <ul class="space-y-4">
              {[
                "Children's picture book full-spread illustration (32+ pages)",
                "Graphic novel & comic book panel art and inking",
                "Fantasy & sci-fi book cover painting",
                "Character concept art, turnarounds, and expression sheets",
                "Interior spot illustrations and chapter header art",
                "Map & world-building illustrations for fiction",
                "Non-fiction diagrams, infographics, and editorial art",
                "Coloring book line art and activity page design",
              ].map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex-shrink-0 w-5 h-5 rounded-full bg-fuchsia-500 text-white flex items-center justify-center text-xs font-black">✓</span>
                  <span class="text-sm text-gray-200 leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Style cards */}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {[
              {
                icon: "🖌️",
                title: "Children's Book Illustration",
                desc: "Vibrant, age-appropriate spreads that make every page-turn magical for young readers.",
                color: "border-pink-500/50 hover:border-pink-400",
              },
              {
                icon: "✒️",
                title: "Graphic Novel Art",
                desc: "Sequential panel-by-panel storytelling with precise ink work and dramatic composition.",
                color: "border-violet-500/50 hover:border-violet-400",
              },
              {
                icon: "🏰",
                title: "Fantasy Cover Art",
                desc: "Epic, cinematic cover paintings that stop browsers in their tracks and drive sales.",
                color: "border-cyan-500/50 hover:border-cyan-400",
              },
              {
                icon: "🧬",
                title: "Non-Fiction & Technical",
                desc: "Clear, accurate diagrams, scientific illustrations, and infographics that inform at a glance.",
                color: "border-amber-500/50 hover:border-amber-400",
              },
            ].map((card) => (
              <div class={`bg-black/60 border-2 ${card.color} p-6 rounded-2xl transition-colors duration-300`}>
                <div class="text-3xl mb-4">{card.icon}</div>
                <h3 class="font-black text-sm text-white uppercase mb-2 leading-snug">{card.title}</h3>
                <p class="text-xs text-gray-300 leading-relaxed">{card.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ── HOW WE WORK ── */}
    <section
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-fuchsia-900/40"
      style="background-image: url('/images/services/illustrations-book/how-we-work.png');"
    >
      <div class="absolute inset-0 bg-[#0d0015]/88 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-black uppercase tracking-widest text-cyan-400 bg-cyan-400/10 px-4 py-1.5 rounded-full border border-cyan-400/30 inline-block mb-3">
            FROM BLANK CANVAS TO FINAL FILE
          </span>
          <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white drop-shadow-md">
            OUR CREATIVE PROCESS
          </h2>
          <p class="text-sm text-gray-300 mt-3">
            A transparent, collaborative workflow designed to bring your vision to life — on time and beyond expectation.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            {
              step: "01",
              title: "Brief & Vision",
              desc: "We deep-dive into your story, characters, target audience, and preferred art style through a detailed creative brief.",
              icon: "📋",
              accent: "text-fuchsia-400 border-fuchsia-400/30 bg-fuchsia-400/10",
            },
            {
              step: "02",
              title: "Concept Sketches",
              desc: "Our illustrators deliver loose pencil sketches and style samples for your review — nothing proceeds without your approval.",
              icon: "✏️",
              accent: "text-violet-400 border-violet-400/30 bg-violet-400/10",
            },
            {
              step: "03",
              title: "Full Art & Revisions",
              desc: "Approved sketches are rendered into full colour art with dedicated revision rounds to perfect every detail.",
              icon: "🎨",
              accent: "text-cyan-400 border-cyan-400/30 bg-cyan-400/10",
            },
            {
              step: "04",
              title: "Print-Ready Delivery",
              desc: "Final files delivered in high-resolution CMYK/RGB formats ready for print, ebook, and web — all formats included.",
              icon: "📦",
              accent: "text-amber-400 border-amber-400/30 bg-amber-400/10",
            },
          ].map((item) => (
            <div class="bg-black/70 border-2 border-white/15 rounded-3xl p-6 hover:border-fuchsia-500/50 transition-all duration-300 group">
              <div class="flex items-center justify-between mb-5">
                <span class={`text-[11px] font-black uppercase tracking-widest px-3 py-1 rounded-full border ${item.accent}`}>
                  STEP {item.step}
                </span>
                <span class="text-2xl group-hover:scale-125 transition-transform duration-300">{item.icon}</span>
              </div>
              <h3 class="font-black text-lg text-white uppercase mb-2">{item.title}</h3>
              <p class="text-xs text-gray-300 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── WHY CHOOSE US ── */}
    <section
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-fuchsia-900/40"
      style="background-image: url('/images/services/illustrations-book/why-choose-us.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-[#0d0015]/92 via-[#0d0015]/85 to-[#0d0015]/95 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-xs font-black uppercase tracking-widest text-fuchsia-400 bg-fuchsia-400/10 px-4 py-1.5 rounded-full border border-fuchsia-400/30 inline-block mb-3">
            THE HEARST DIFFERENCE
          </span>
          <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">
            WHY AUTHORS CHOOSE OUR ILLUSTRATORS
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
          {/* Big left card */}
          <div class="lg:col-span-1 bg-gradient-to-b from-fuchsia-900/60 to-violet-900/60 border-2 border-fuchsia-500/50 rounded-3xl p-8 flex flex-col justify-between">
            <div>
              <span class="text-4xl mb-5 block">🏆</span>
              <h3 class="font-black text-2xl text-white uppercase mb-4 leading-tight">
                30+ ARTISTS. ONE SEAMLESS STUDIO.
              </h3>
              <p class="text-sm text-gray-200 leading-relaxed">
                Our in-house roster covers watercolor, gouache, digital painting,
                vector, ink, and mixed media — meaning we match the perfect artist
                to your project rather than forcing your project to fit one style.
              </p>
            </div>
            <div class="mt-8 flex items-center gap-3 bg-black/40 rounded-2xl p-4 border border-white/10">
              <span class="text-amber-400 text-xl">★★★★★</span>
              <span class="text-xs text-gray-300 font-bold">500+ illustrated titles published</span>
            </div>
          </div>

          {/* Right 2×2 grid */}
          <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-5">
            {[
              {
                icon: "🤝",
                title: "True Creative Collaboration",
                desc: "You're involved at every sketch, every revision, every colour decision — it's your art as much as ours.",
                border: "border-violet-500/40 hover:border-violet-400",
              },
              {
                icon: "⚡",
                title: "Fast Turnaround Times",
                desc: "Dedicated project managers keep timelines tight — chapter books in weeks, not months.",
                border: "border-cyan-500/40 hover:border-cyan-400",
              },
              {
                icon: "🖨️",
                title: "Print-Perfect Colour Science",
                desc: "CMYK profiles, bleed margins, and resolution checks done in-house so your printed book matches what you see on screen.",
                border: "border-amber-500/40 hover:border-amber-400",
              },
              {
                icon: "🔄",
                title: "Unlimited Revision Rounds",
                desc: "We don't lock you into a fixed number of tweaks — we iterate until the art is exactly right.",
                border: "border-fuchsia-500/40 hover:border-fuchsia-400",
              },
            ].map((box) => (
              <div class={`bg-black/60 border-2 ${box.border} p-6 rounded-2xl transition-colors duration-300`}>
                <div class="text-3xl mb-3">{box.icon}</div>
                <h3 class="font-black text-sm text-white uppercase mb-2">{box.title}</h3>
                <p class="text-xs text-gray-300 leading-relaxed">{box.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ── CTA ── */}
    <section
      class="relative py-16 sm:py-28 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-b border-fuchsia-900/40"
      style="background-image: url('/images/services/illustrations-book/cta.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-[#0d0015]/95 via-fuchsia-950/90 to-[#0d0015]/95 pointer-events-none"></div>

      {/* Decorative blobs */}
      <div class="absolute top-0 left-1/3 w-96 h-96 bg-fuchsia-600/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-0 right-1/4 w-72 h-72 bg-violet-600/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <span class="text-xs font-black uppercase tracking-widest text-amber-400 bg-amber-400/10 px-4 py-1.5 rounded-full border border-amber-400/30 inline-block mb-5">
          🖌️ YOUR STORY DESERVES UNFORGETTABLE ART
        </span>
        <h2 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-white mb-6 drop-shadow-2xl leading-none">
          LET'S CREATE SOMETHING
          <span class="bg-gradient-to-r from-fuchsia-400 via-violet-400 to-cyan-400 bg-clip-text text-transparent block">
            EXTRAORDINARY.
          </span>
        </h2>
        <p class="text-sm sm:text-base text-gray-200 max-w-2xl mx-auto mb-8 leading-relaxed font-medium">
          Talk to our illustration directors for a free creative consultation —
          no commitment, just inspiration.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="h-12 px-8 bg-fuchsia-600 hover:bg-fuchsia-500 text-white font-black text-sm uppercase tracking-wider rounded-full transition-all transform hover:scale-105 inline-flex items-center gap-2 shadow-2xl border border-white/20"
          >
            <span>Get a Free Illustration Consultation</span>
          </a>
          <a
            href="/packages"
            class="h-12 px-8 bg-amber-400 hover:bg-amber-300 text-black font-black text-sm uppercase tracking-wider rounded-full transition-all transform hover:scale-105 inline-flex items-center shadow-2xl"
          >
            <span>Browse Art Packages</span>
          </a>
        </div>
      </div>
    </section>

    <EverythingSection client:load />
    <Footer />
  </div>
</Layout>
