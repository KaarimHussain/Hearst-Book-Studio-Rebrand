---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import InnerPageHero from "../../components/InnerPageHero.astro";
import BookPrintingIntro from "../../components/BookPrintingIntro.astro";
import BookPrintingFeatures from "../../components/BookPrintingFeatures.astro";
import HowWeWork from "../../components/HowWeWork.astro";
import WhyChooseUs from "../../components/WhyChooseUs.astro";
import EverythingSection from "../../components/EverythingSection.tsx";
import Footer from "../../components/Footer.astro";
---

<Layout title="Book Printing — HearEst Book Studio">
  <div class="relative">
    <Navbar client:load />
    <InnerPageHero
      bgImg="/images/3d9b47f5-2795-4727-b202-8b16c8a3f1fe.webp"
      heading="Print Your Book with Precision and Quality!"
    />
  </div>

  <BookPrintingIntro />
  <BookPrintingFeatures />
  <HowWeWork />

  <WhyChooseUs
    bgImg="/images/05edc24b-0f3b-4321-bdb0-2f353eaa2b68.webp"
    bookImg="/images/bc7d7751-afdc-4f52-8a2d-58053a5cc36f.webp"
  />

  <EverythingSection client:load />
  <Footer />
</Layout>
