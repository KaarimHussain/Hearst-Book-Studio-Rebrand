---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import SelfHelpShowcase from "../../components/SelfHelpShowcase.tsx";
import EverythingSection from "../../components/EverythingSection.tsx";
import Footer from "../../components/Footer.astro";
---

<Layout title="Self-Help & Personal Growth Publishing — Hearst Book Studio">
  <div class="relative bg-black text-white">
    <Navbar client:load />

    {/* SECTION 1: Hero Cover Section */}
    <section 
      class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 bg-cover bg-center bg-no-repeat overflow-hidden"
      style="background-image: url('/images/genre/self-help/section-1.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/45 to-black/65 pointer-events-none"></div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-[#3075ba]/30 border border-[#3075ba]/50 px-4 py-1.5 mb-6">
          <span class="w-2 h-2 rounded-full bg-[#3075ba]"></span>
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba]">
            SELF-HELP & PERSONAL GROWTH STUDIO
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold uppercase tracking-tight text-white leading-tight mb-6 drop-shadow-xl">
          EMPOWERING MINDS & TRANSFORMING LIVES THROUGH <span class="text-[#3075ba]">IMPACTFUL BOOKS</span>
        </h1>

        <p class="text-sm sm:text-base md:text-lg text-gray-100 font-medium max-w-3xl mx-auto leading-relaxed mb-8 sm:mb-10 drop-shadow-md">
          From habit transformation and mindset mastery to wellness guides and motivational workbooks, Hearst Book Studio equips coaches, experts, and authors to publish bestsellers that inspire global change.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="#self-help-showcase"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-sm uppercase tracking-wider hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
          >
            <span>Explore Self-Help Titles</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="/contact"
            class="h-12 px-8 bg-black/40 text-white font-bold text-sm uppercase tracking-wider border-2 border-white hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>Publish Your Book</span>
          </a>
        </div>
      </div>
    </section>

    {/* SECTION 2: Pillars */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/self-help/section-2.png');"
    >
      <div class="absolute inset-0 bg-black/50 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2 drop-shadow-sm">
            TRANSFORMATIVE EDITORIAL STANDARDS
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white drop-shadow-md">
            CRAFTED FOR ACTION, CLARITY & PERSONAL MASTERY
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          <div class="bg-black/65 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors group">
            <div class="w-12 h-12 bg-[#3075ba]/30 border border-[#3075ba]/60 flex items-center justify-center text-[#3075ba] font-bold text-lg mb-6 group-hover:bg-[#3075ba] group-hover:text-white transition-colors">
              01
            </div>
            <h3 class="font-extrabold text-lg text-white uppercase mb-3">
              Actionable Framework Editing
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Structuring your core philosophy, exercises, reflection prompts, and takeaway steps to ensure maximum reader implementation and retention.
            </p>
          </div>

          <div class="bg-black/65 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors group">
            <div class="w-12 h-12 bg-[#3075ba]/30 border border-[#3075ba]/60 flex items-center justify-center text-[#3075ba] font-bold text-lg mb-6 group-hover:bg-[#3075ba] group-hover:text-white transition-colors">
              02
            </div>
            <h3 class="font-extrabold text-lg text-white uppercase mb-3">
              Motivational Cover & Workbook Layout
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              High-impact cover design paired with spacious workbook interior typography, fill-in prompt boxes, and clean visual breakdowns.
            </p>
          </div>

          <div class="bg-black/65 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors group">
            <div class="w-12 h-12 bg-[#3075ba]/30 border border-[#3075ba]/60 flex items-center justify-center text-[#3075ba] font-bold text-lg mb-6 group-hover:bg-[#3075ba] group-hover:text-white transition-colors">
              03
            </div>
            <h3 class="font-extrabold text-lg text-white uppercase mb-3">
              Speaker & Coach Brand Integration
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Aligning your book release with online courses, keynote speaking engagements, coaching funnels, and global bestseller distribution.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 3: Curated Self-Help Portfolio Showcase */}
    <section 
      id="self-help-showcase"
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/self-help/section-3.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2 drop-shadow-sm">
            OUR FEATURED SELF-HELP CATALOGUE
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white drop-shadow-md">
            EXPLORE PUBLISHED SELF-HELP TITLES
          </h2>
          <p class="text-xs sm:text-sm text-gray-200 mt-3 font-medium">
            Browse our curated showcase of personal growth, mindfulness, and productivity bestsellers.
          </p>
        </div>

        <SelfHelpShowcase client:load />
      </div>
    </section>

    {/* SECTION 4: Sub-Categories Specialization */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/self-help/section-4.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/50 to-black/70 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2 drop-shadow-sm">
            NICHES & SPECIALIZATIONS
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white drop-shadow-md">
            SELF-HELP CATEGORIES WE PUBLISH
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            {
              title: "Habit Transformation & Mindset",
              desc: "Behavioral psychology, habit formation systems, mental resilience, and daily routine optimization.",
            },
            {
              title: "Productivity & Peak Performance",
              desc: "Time management, deep focus strategies, goal achievement frameworks, and executive efficiency.",
            },
            {
              title: "Mindfulness, Stress & Mental Health",
              desc: "Meditation guides, emotional regulation, anxiety management, and inner peace practices.",
            },
            {
              title: "Relationships & Communication",
              desc: "Interpersonal dynamics, conflict resolution, emotional intelligence, and marriage/family guides.",
            },
            {
              title: "Financial Freedom & Wealth Mindset",
              desc: "Money psychology, personal budgeting, wealth building, and financial independence strategies.",
            },
            {
              title: "Inspirational & Motivational Memoirs",
              desc: "Overcoming adversity, true transformation stories, life lessons, and empowering personal journeys.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/60 border border-white/15 p-6 sm:p-7 hover:border-[#3075ba] transition-colors">
              <div class="text-[#3075ba] font-bold text-xs uppercase tracking-widest mb-2">
                Niche #{idx + 1}
              </div>
              <h3 class="font-extrabold text-base sm:text-lg text-white uppercase mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 5: Publishing Process */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/self-help/section-5.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2 drop-shadow-sm">
            4-STEP TRANSFORMATIONAL ROADMAP
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white drop-shadow-md">
            THE SELF-HELP PUBLISHING ROADMAP
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            {
              step: "PHASE 01",
              title: "Concept & Framework",
              desc: "Defining your core transformation method, reader target persona, and chapter architecture.",
            },
            {
              step: "PHASE 02",
              title: "Developmental Editing",
              desc: "Refining chapter tone, adding reflection exercises, case studies, and actionable takeaways.",
            },
            {
              step: "PHASE 03",
              title: "Workbook & Cover Design",
              desc: "Crafting a compelling cover and elegant interior layout formatted for active note-taking.",
            },
            {
              step: "PHASE 04",
              title: "Global Multi-Platform Release",
              desc: "Launching across Amazon, Audible Audiobook, IngramSpark, and international bookstores.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/65 border border-white/20 p-6 relative group hover:border-[#3075ba] transition-colors">
              <span class="text-[10px] font-extrabold text-[#3075ba] uppercase tracking-widest block mb-2">
                {item.step}
              </span>
              <h3 class="font-extrabold text-base text-white uppercase mb-3">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 6: Call-To-Action Banner */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-b border-[#3075ba]/40"
      style="background-image: url('/images/genre/self-help/section-6.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-slate-950/60 to-black/70 pointer-events-none"></div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-3 drop-shadow-sm">
          INSPIRE THOUSANDS OF READERS WORLDWIDE
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-white mb-6 drop-shadow-md">
          READY TO PUBLISH YOUR SELF-HELP BOOK?
        </h2>
        <p class="text-sm sm:text-base text-gray-200 max-w-2xl mx-auto mb-8 leading-relaxed">
          Speak with our senior self-help editors and publishing strategists to receive a free manuscript review and tailored bestseller launch plan.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-sm uppercase tracking-wider hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
          >
            <span>Request Free Manuscript Critique</span>
          </a>
          <a
            href="/packages"
            class="h-12 px-8 bg-black/40 text-white font-bold text-sm uppercase tracking-wider border-2 border-white hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>View Publishing Packages</span>
          </a>
        </div>
      </div>
    </section>

    <EverythingSection client:load />
    <Footer />
  </div>
</Layout>
