---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import SelfHelpShowcase from "../../components/SelfHelpShowcase.tsx";
import EverythingSection from "../../components/EverythingSection.tsx";
import Footer from "../../components/Footer.astro";
---

<Layout title="Self-Help & Personal Growth Publishing — Hearst Book Studio">
  <div class="relative bg-black text-white">
    <Navbar client:load />

    {/* SECTION 1: Empowering Mindset Hero */}
    <section 
      class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 bg-cover bg-center bg-no-repeat overflow-hidden"
      style="background-image: url('/images/genre/self-help/section-1.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/75 pointer-events-none"></div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-[#3075ba]/30 border border-[#3075ba]/60 px-4 py-1.5 mb-6">
          <span class="w-2.5 h-2.5 bg-[#3075ba] rounded-full animate-ping"></span>
          <span class="text-xs font-bold uppercase tracking-widest text-white">
            SELF-HELP & PERSONAL GROWTH STUDIO
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-7xl font-extrabold uppercase tracking-tight text-white leading-tight mb-6 drop-shadow-xl">
          EMPOWER MINDS & <span class="text-[#3075ba]">TRANSFORM LIVES</span> THROUGH BOOKS
        </h1>

        <p class="text-sm sm:text-base md:text-lg text-gray-100 font-medium max-w-3xl mx-auto leading-relaxed mb-8 sm:mb-10 drop-shadow-md">
          From mindset masterclasses and productivity workbooks to mindfulness guides and emotional healing books, Hearst Book Studio turns life wisdom into bestselling self-help literature.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="#self-help-showcase"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-xs uppercase tracking-widest hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
          >
            <span>Explore Self-Help Catalogue</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="/contact"
            class="h-12 px-8 bg-black/50 text-white font-bold text-xs uppercase tracking-widest border border-white/40 hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>Publish Your Framework</span>
          </a>
        </div>
      </div>
    </section>

    {/* SECTION 2: Transformation Pillars (3 Action Cards) */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/self-help/section-2.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            ACTION-DRIVEN EDITORIAL ARCHITECTURE
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            DESIGNED FOR REAL-WORLD RESULTS
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          <div class="bg-black/75 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors group">
            <div class="text-3xl mb-4">💡</div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Actionable Framework Editing
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Structuring your core philosophy into memorable step-by-step frameworks, exercises, chapter summaries, and action steps.
            </p>
          </div>

          <div class="bg-black/75 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors group">
            <div class="text-3xl mb-4">📝</div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Companion Workbook Design
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Creating companion action workbooks, daily habit trackers, reflection prompts, and fill-in journal layouts.
            </p>
          </div>

          <div class="bg-black/75 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors group">
            <div class="text-3xl mb-4">🎙️</div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Speaker & Coach Positioning
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Leveraging your self-help book to build online coaching courses, keynote speaking tours, and high-converting audience funnels.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 3: Showcase */}
    <section 
      id="self-help-showcase"
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/self-help/section-3.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            SELF-HELP PORTFOLIO
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            EXPLORE PUBLISHED SELF-HELP BOOKS
          </h2>
          <p class="text-xs sm:text-sm text-gray-200 mt-3 font-medium">
            Search personal growth, productivity, and wellness bestsellers.
          </p>
        </div>

        <SelfHelpShowcase client:load />
      </div>
    </section>

    {/* SECTION 4: Growth Niches Grid */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/self-help/section-4.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/50 to-black/70 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            TRANSFORMATION DOMAINS
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            SELF-HELP CATEGORIES WE PUBLISH
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            {
              title: "Mindset & Personal Transformation",
              desc: "Overcoming limiting beliefs, building resilience, mental toughness, and cognitive reframing.",
            },
            {
              title: "Productivity, Time & Habits",
              desc: "Atomic habit formation, focus optimization, time blocking, and goal achievement systems.",
            },
            {
              title: "Mindfulness, Anxiety & Wellness",
              desc: "Stress reduction, breathwork guides, emotional mastery, and holistic mental wellness.",
            },
            {
              title: "Relationships & Communication",
              desc: "Active listening, emotional intelligence, conflict resolution, and healthy boundaries.",
            },
            {
              title: "Financial Mindset & Abundance",
              desc: "Money psychology, wealth consciousness, financial freedom habits, and career growth.",
            },
            {
              title: "Inspirational Memoirs & Growth",
              desc: "Personal story-driven self-help combining real life struggle with practical life lessons.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/60 border border-white/15 p-6 sm:p-7 hover:border-[#3075ba] transition-colors">
              <div class="text-[#3075ba] font-bold text-xs uppercase tracking-widest mb-2">
                Niche #{idx + 1}
              </div>
              <h3 class="font-extrabold text-base sm:text-lg text-white uppercase mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 5: Author-to-Coach Roadmap */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/self-help/section-5.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            AUTHOR TO THOUGHT LEADER
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            THE SELF-HELP PUBLISHING ROADMAP
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            {
              step: "PHASE 01",
              title: "Methodology Outline",
              desc: "Mapping your core framework, core exercises, and key reader takeaways.",
            },
            {
              step: "PHASE 02",
              title: "Developmental Editing",
              desc: "Refining chapter flow, tone polishing, and structuring companion workbook exercises.",
            },
            {
              step: "PHASE 03",
              title: "Cover & Interior Formatting",
              desc: "Designing motivational cover artwork and clean interior typography for high readability.",
            },
            {
              step: "PHASE 04",
              title: "Bestseller Launch",
              desc: "Global distribution across Amazon, Audible audiobooks, and podcast promotional tours.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/65 border border-white/20 p-6 relative group hover:border-[#3075ba] transition-colors">
              <span class="text-[10px] font-extrabold text-[#3075ba] uppercase tracking-widest block mb-2">
                {item.step}
              </span>
              <h3 class="font-extrabold text-base text-white uppercase mb-3">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 6: Empowerment CTA */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-b border-[#3075ba]/40"
      style="background-image: url('/images/genre/self-help/section-6.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-slate-950/70 to-black/80 pointer-events-none"></div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-3">
          SHARE YOUR WISDOM & INSPIRE READERS WORLDWIDE
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-white mb-6">
          READY TO PUBLISH YOUR SELF-HELP BOOK?
        </h2>
        <p class="text-sm sm:text-base text-gray-200 max-w-2xl mx-auto mb-8 leading-relaxed">
          Schedule a consultation with our self-help publishing directors to receive a free manuscript review and tailored release plan.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-xs uppercase tracking-widest hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
          >
            <span>Request Free Manuscript Review</span>
          </a>
          <a
            href="/packages"
            class="h-12 px-8 bg-black/50 text-white font-bold text-xs uppercase tracking-widest border border-white/40 hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>View Publishing Packages</span>
          </a>
        </div>
      </div>
    </section>

    <EverythingSection client:load />
    <Footer />
  </div>
</Layout>
