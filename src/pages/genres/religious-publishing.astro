---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import ReligiousPublishingShowcase from "../../components/ReligiousPublishingShowcase.tsx";
import EverythingSection from "../../components/EverythingSection.tsx";
import Footer from "../../components/Footer.astro";
---

<Layout title="Religious & Faith-Based Publishing — Hearst Book Studio">
  <div class="relative bg-black text-white">
    <Navbar client:load />

    {/* SECTION 1: Sacred Reverent Hero */}
    <section 
      class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 bg-cover bg-center bg-no-repeat overflow-hidden"
      style="background-image: url('/images/genre/religious-publishing/section-1.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/55 to-black/80 pointer-events-none"></div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-[#3075ba]/25 border border-[#3075ba]/60 px-5 py-1.5 mb-6">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba]">
            ✝ RELIGIOUS & FAITH PUBLISHING STUDIO
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-7xl font-extrabold uppercase tracking-tight text-white leading-tight mb-6 drop-shadow-xl">
          HONORING SACRED TEXTS & <span class="font-serif text-[#3075ba]">SPIRITUAL SCHOLARSHIP</span>
        </h1>

        <p class="text-sm sm:text-base md:text-lg text-gray-100 font-medium max-w-3xl mx-auto leading-relaxed mb-8 sm:mb-10 drop-shadow-md">
          From theological treatises and devotional study guides to ministry publications and spiritual growth books, Hearst Book Studio provides reverent editing, sacred typesetting, and global distribution.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="#rel-showcase"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-xs uppercase tracking-widest hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl border border-white/20"
          >
            <span>Explore Faith Catalogue</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="/contact"
            class="h-12 px-8 bg-black/50 text-white font-bold text-xs uppercase tracking-widest border border-white/40 hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>Publish Your Ministry Book</span>
          </a>
        </div>
      </div>
    </section>

    {/* SECTION 2: Sacred Pillars (Two-Column Classic Layout) */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/religious-publishing/section-2.png');"
    >
      <div class="absolute inset-0 bg-black/60 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            SACRED ACCURACY & EDITORIAL CARE
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            REVERENT TYPESETTING & SCRIPTURAL PRECISION
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          <div class="bg-black/80 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors relative">
            <div class="w-10 h-10 bg-[#3075ba]/20 border border-[#3075ba] flex items-center justify-center text-[#3075ba] font-serif font-bold text-lg mb-6">
              ✝
            </div>
            <h3 class="font-extrabold text-lg text-white uppercase mb-3">
              Theological Fact-Checking & Indexing
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Precise verse citation cross-referencing, scripture index generation, and theological accuracy proofreading.
            </p>
          </div>

          <div class="bg-black/80 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors relative">
            <div class="w-10 h-10 bg-[#3075ba]/20 border border-[#3075ba] flex items-center justify-center text-[#3075ba] font-serif font-bold text-lg mb-6">
              📖
            </div>
            <h3 class="font-extrabold text-lg text-white uppercase mb-3">
              Two-Column Bible Typesetting
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Classic two-column layout formatting, red-letter printing support, foil cover stamping, and genuine leather-bound editions.
            </p>
          </div>

          <div class="bg-black/80 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors relative">
            <div class="w-10 h-10 bg-[#3075ba]/20 border border-[#3075ba] flex items-center justify-center text-[#3075ba] font-serif font-bold text-lg mb-6">
              🕊️
            </div>
            <h3 class="font-extrabold text-lg text-white uppercase mb-3">
              Church & Bookstore Distribution
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Worldwide availability through Amazon, Christian bookstores, church bulk distribution networks, and digital platforms.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 3: Showcase */}
    <section 
      id="rel-showcase"
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/religious-publishing/section-3.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            FAITH CATALOGUE
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            EXPLORE PUBLISHED RELIGIOUS BOOKS
          </h2>
          <p class="text-xs sm:text-sm text-gray-200 mt-3 font-medium">
            Search theology, devotionals, and ministry literature.
          </p>
        </div>

        <ReligiousPublishingShowcase client:load />
      </div>
    </section>

    {/* SECTION 4: Sub-Categories */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/religious-publishing/section-4.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/50 to-black/70 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            FAITH CATEGORIES
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            RELIGIOUS DOMAINS WE PUBLISH
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            {
              title: "Theology & Scriptural Exegesis",
              desc: "Deep biblical commentary, doctrine study guides, historical theology, and academic manuscripts.",
            },
            {
              title: "Devotionals & Prayer Guides",
              desc: "365-day prayer journals, guided scripture meditation, and daily family worship guides.",
            },
            {
              title: "Pastoral Leadership & Ministry",
              desc: "Church planting, pastoral care, sermon series workbooks, and leadership strategies.",
            },
            {
              title: "Interfaith & Comparative Religion",
              desc: "Scholarly comparative studies, interfaith dialogue, and cultural philosophy.",
            },
            {
              title: "Christian Memoirs & Testimonies",
              desc: "Personal faith journeys, missionary accounts, conversion stories, and spiritual triumphs.",
            },
            {
              title: "Youth Ministry & Sunday School",
              desc: "Children's Bible storybooks, youth group curriculum, and interactive workbooks.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/60 border border-white/15 p-6 sm:p-7 hover:border-[#3075ba] transition-colors">
              <div class="text-[#3075ba] font-bold text-xs uppercase tracking-widest mb-2 font-serif">
                Domain #{idx + 1}
              </div>
              <h3 class="font-extrabold text-base sm:text-lg text-white uppercase mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 5: Ministry Roadmap */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/religious-publishing/section-5.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            4-STEP MINISTRY ROADMAP
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            THE RELIGIOUS PUBLISHING ROADMAP
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            {
              step: "PHASE 01",
              title: "Scripture & Text Review",
              desc: "Reviewing biblical references, verse formatting, and chapter structure.",
            },
            {
              step: "PHASE 02",
              title: "Theological Editing",
              desc: "Copyediting, footnote formatting, and index creation for theological accuracy.",
            },
            {
              step: "PHASE 03",
              title: "Reverent Interior Design",
              desc: "Two-column bible typesetting, elegant drop caps, and foil-stamped cover design.",
            },
            {
              step: "PHASE 04",
              title: "Distribution & Bulk Ordering",
              desc: "Global distribution across bookstores, online platforms, and church bulk printing.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/65 border border-white/20 p-6 relative group hover:border-[#3075ba] transition-colors">
              <span class="text-[10px] font-extrabold text-[#3075ba] uppercase tracking-widest block mb-2">
                {item.step}
              </span>
              <h3 class="font-extrabold text-base text-white uppercase mb-3">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 6: Ministry CTA */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-b border-[#3075ba]/40"
      style="background-image: url('/images/genre/religious-publishing/section-6.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-slate-950/70 to-black/80 pointer-events-none"></div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-3 font-serif">
          Spread Your Ministry & Message Worldwide
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-white mb-6">
          READY TO PUBLISH YOUR RELIGIOUS WORK?
        </h2>
        <p class="text-sm sm:text-base text-gray-200 max-w-2xl mx-auto mb-8 leading-relaxed">
          Speak with our religious publishing directors to receive a free manuscript evaluation and publishing proposal.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-xs uppercase tracking-widest hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl border border-white/20"
          >
            <span>Request Free Manuscript Evaluation</span>
          </a>
          <a
            href="/packages"
            class="h-12 px-8 bg-black/50 text-white font-bold text-xs uppercase tracking-widest border border-white/40 hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>View Publishing Packages</span>
          </a>
        </div>
      </div>
    </section>

    <EverythingSection client:load />
    <Footer />
  </div>
</Layout>
