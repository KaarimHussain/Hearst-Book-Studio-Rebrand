---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import BiographiesShowcase from "../../components/BiographiesShowcase.tsx";
import EverythingSection from "../../components/EverythingSection.tsx";
import Footer from "../../components/Footer.astro";
---

<Layout title="Biographies & Autobiographies — Hearst Book Studio">
  <div class="relative bg-black text-white">
    <Navbar client:load />

    {/* SECTION 1: Heritage Literary Hero */}
    <section 
      class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 bg-cover bg-center bg-no-repeat overflow-hidden"
      style="background-image: url('/images/genre/biographies-and-autobiographies/section-1.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/50 to-black/80 pointer-events-none"></div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-[#3075ba]/20 border border-[#3075ba]/50 px-4 py-1.5 mb-6">
          <span class="w-2 h-2 rounded-full bg-[#3075ba]"></span>
          <span class="text-xs font-bold uppercase tracking-widest text-white">
            BIOGRAPHY & MEMOIR ARCHIVE
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-7xl font-extrabold uppercase tracking-tight text-white leading-tight mb-6 drop-shadow-xl">
          PRESERVING EXTRAORDINARY LIVES & <span class="font-serif italic text-[#3075ba] lowercase">historical legacies</span>
        </h1>

        <p class="text-sm sm:text-base md:text-lg text-gray-100 font-medium max-w-3xl mx-auto leading-relaxed mb-8 sm:mb-10 drop-shadow-md">
          From intimate family memoirs and executive leadership journeys to landmark historical biographies, Hearst Book Studio turns life stories into timeless heirlooms.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="#bio-showcase"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-xs uppercase tracking-widest hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
          >
            <span>Explore Published Memoirs</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="/contact"
            class="h-12 px-8 bg-black/50 text-white font-bold text-xs uppercase tracking-widest border border-white/40 hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>Confidential Story Consultation</span>
          </a>
        </div>
      </div>
    </section>

    {/* SECTION 2: Archival & Heritage Pillars (Unique Timeline Split) */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/biographies-and-autobiographies/section-2.png');"
    >
      <div class="absolute inset-0 bg-black/60 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            CONFIDENTIAL GHOSTWRITING & RESEARCH
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            HONORING TRUTH, EMOTION & HISTORICAL IMPACT
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        {/* 3 Heritage Columns with Delicate Lines */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          <div class="bg-black/80 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors relative">
            <div class="text-xs font-bold text-[#3075ba] uppercase tracking-widest mb-2 font-serif italic">
              — Chapter 01 —
            </div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Executive Ghostwriting Interviews
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              In-depth, empathetic audio interviews conducted by senior biographers to capture your authentic voice, personal anecdotes, and key milestones.
            </p>
          </div>

          <div class="bg-black/80 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors relative">
            <div class="text-xs font-bold text-[#3075ba] uppercase tracking-widest mb-2 font-serif italic">
              — Chapter 02 —
            </div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Archival & Photo Restoration
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              High-resolution photograph scanning, family tree genealogy inserts, historical timeline charting, and glossy photo spreads.
            </p>
          </div>

          <div class="bg-black/80 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors relative">
            <div class="text-xs font-bold text-[#3075ba] uppercase tracking-widest mb-2 font-serif italic">
              — Chapter 03 —
            </div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Heirloom Hardcover Editions
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Collector's leather-bound editions for family archives or global distribution across Amazon, Audible, and bookstores worldwide.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 3: Showcase */}
    <section 
      id="bio-showcase"
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/biographies-and-autobiographies/section-3.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            BIOGRAPHY CATALOGUE
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            EXPLORE PUBLISHED MEMOIRS & HISTORIES
          </h2>
          <p class="text-xs sm:text-sm text-gray-200 mt-3 font-medium">
            Search personal memoirs, corporate histories, and biographical works.
          </p>
        </div>

        <BiographiesShowcase client:load />
      </div>
    </section>

    {/* SECTION 4: Sub-Categories */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/biographies-and-autobiographies/section-4.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/50 to-black/70 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            MEMOIR STYLES & CATEGORIES
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            BIOGRAPHY STYLES WE PUBLISH
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            {
              title: "Personal Memoirs & Family History",
              desc: "Heartfelt personal stories, ancestral origins, and family legacies bound for generations.",
            },
            {
              title: "Executive & Corporate Autobiographies",
              desc: "Business leadership journeys, company founding stories, and industry transformation memoirs.",
            },
            {
              title: "Historical & Political Biographies",
              desc: "Rigorously researched portraits of world leaders, historical figures, and cultural icons.",
            },
            {
              title: "Overcoming Adversity Stories",
              desc: "Inspiring accounts of medical triumphs, trauma recovery, resilience, and personal rebirth.",
            },
            {
              title: "Celebrity & Performing Arts Memoirs",
              desc: "Behind-the-scenes accounts of artists, musicians, athletes, and public figures.",
            },
            {
              title: "Academic & Scholarly Biographies",
              desc: "Footnoted, cited intellectual biographies detailing scientists, philosophers, and inventors.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/60 border border-white/15 p-6 sm:p-7 hover:border-[#3075ba] transition-colors">
              <div class="text-[#3075ba] font-bold text-xs uppercase tracking-widest mb-2 font-serif italic">
                Style #{idx + 1}
              </div>
              <h3 class="font-extrabold text-base sm:text-lg text-white uppercase mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 5: Interview & Writing Roadmap */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/biographies-and-autobiographies/section-5.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            4-STEP MEMOIR ROADMAP
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            HOW WE WRITE & PUBLISH YOUR MEMOIR
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            {
              step: "PHASE 01",
              title: "Recorded Interviews",
              desc: "Structured audio interviews to extract timelines, anecdotes, and core personal themes.",
            },
            {
              step: "PHASE 02",
              title: "Ghostwriting & Polishing",
              desc: "Crafting chapter drafts in your distinct voice with narrative tension and emotional resonance.",
            },
            {
              step: "PHASE 03",
              title: "Photo Archiving & Layout",
              desc: "Restoring personal photographs and designing elegant typography with photo inserts.",
            },
            {
              step: "PHASE 04",
              title: "Printing & Distribution",
              desc: "Custom hardcover runs, audiobooks narrated in your voice, and worldwide retail release.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/65 border border-white/20 p-6 relative group hover:border-[#3075ba] transition-colors">
              <span class="text-[10px] font-extrabold text-[#3075ba] uppercase tracking-widest block mb-2">
                {item.step}
              </span>
              <h3 class="font-extrabold text-base text-white uppercase mb-3">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 6: Heirloom CTA Banner */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-b border-[#3075ba]/40"
      style="background-image: url('/images/genre/biographies-and-autobiographies/section-6.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-slate-950/70 to-black/80 pointer-events-none"></div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-3 font-serif italic">
          Your Story Deserves to Be Written & Remembered
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-white mb-6">
          READY TO PRESERVE YOUR LIFE LEGACY?
        </h2>
        <p class="text-sm sm:text-base text-gray-200 max-w-2xl mx-auto mb-8 leading-relaxed">
          Speak with our senior biographers and ghostwriting directors for a confidential story consultation and memoir outline.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-xs uppercase tracking-widest hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
          >
            <span>Request Confidential Consultation</span>
          </a>
          <a
            href="/packages"
            class="h-12 px-8 bg-black/50 text-white font-bold text-xs uppercase tracking-widest border border-white/40 hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>View Memoir Packages</span>
          </a>
        </div>
      </div>
    </section>

    <EverythingSection client:load />
    <Footer />
  </div>
</Layout>
