---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import ArtIllustrationsShowcase from "../../components/ArtIllustrationsShowcase.tsx";
import EverythingSection from "../../components/EverythingSection.tsx";
import Footer from "../../components/Footer.astro";
---

<Layout title="Art & Illustration Publishing — Hearst Book Studio">
  <div class="relative bg-black text-white">
    <Navbar client:load />

    {/* SECTION 1: Studio Gallery Hero */}
    <section 
      class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 bg-cover bg-center bg-no-repeat overflow-hidden"
      style="background-image: url('/images/genre/art-and-illustrations/section-1.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70 pointer-events-none"></div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-[#3075ba]/30 border border-[#3075ba]/60 px-4 py-1.5 mb-6">
          <span class="w-2 h-2 rounded-full bg-[#3075ba] animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-widest text-white">
            VISUAL ART & ILLUSTRATION ATELIER
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-7xl font-extrabold uppercase tracking-tight text-white leading-tight mb-6 drop-shadow-xl">
          MASTERPIECE ARTISTRY & <span class="text-[#3075ba] italic font-serif">VISUAL NARRATIVES</span>
        </h1>

        <p class="text-sm sm:text-base md:text-lg text-gray-100 font-medium max-w-3xl mx-auto leading-relaxed mb-8 sm:mb-10 drop-shadow-md">
          From concept art and children's picture book graphics to coffee table monographs and cover artwork, Hearst Book Studio transforms visual imagination into high-definition printed art.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="#art-showcase"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-xs uppercase tracking-widest hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
          >
            <span>Browse Gallery Showcase</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="/contact"
            class="h-12 px-8 bg-black/50 text-white font-bold text-xs uppercase tracking-widest border border-white/40 hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>Submit Your Portfolio</span>
          </a>
        </div>
      </div>
    </section>

    {/* SECTION 2: Atelier Capabilities (Gallery Layout) */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/art-and-illustrations/section-2.png');"
    >
      <div class="absolute inset-0 bg-black/60 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            WORLD-CLASS ART DIRECTION
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            PRECISION COLOR & EDITORIAL ARTistry
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        {/* Gallery Wall Cards */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          <div class="bg-black/75 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors relative">
            <div class="text-xs font-bold text-[#3075ba] uppercase tracking-widest mb-3">
              CAPABILITY 01
            </div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Concept Art & Model Sheets
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              High-detail character design, environmental concept art, and visual storyboards crafted by veteran illustrators.
            </p>
          </div>

          <div class="bg-black/75 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors relative">
            <div class="text-xs font-bold text-[#3075ba] uppercase tracking-widest mb-3">
              CAPABILITY 02
            </div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Full-Bleed Graphic Layout
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Flawless interior page composition, double-page spread formatting, and CMYK color calibration for high-end art books.
            </p>
          </div>

          <div class="bg-black/75 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors relative">
            <div class="text-xs font-bold text-[#3075ba] uppercase tracking-widest mb-3">
              CAPABILITY 03
            </div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Gallery & Luxury Hardcovers
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Spot UV coating, gold/silver foil stamping, cloth-bound hardcover casing, and heavy-grade glossy paper options.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 3: Showcase */}
    <section 
      id="art-showcase"
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/art-and-illustrations/section-3.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            ART PORTFOLIO GALLERY
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            EXPLORE ILLUSTRATED PUBLICATIONS
          </h2>
          <p class="text-xs sm:text-sm text-gray-200 mt-3 font-medium">
            Browse our curated catalogue of art books, concept portfolios, and illustrated titles.
          </p>
        </div>

        <ArtIllustrationsShowcase client:load />
      </div>
    </section>

    {/* SECTION 4: Visual Mediums Grid */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/art-and-illustrations/section-4.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/50 to-black/70 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            SPECIALIZED VISUAL MEDIUMS
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            ART & ILLUSTRATION CATEGORIES WE PUBLISH
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            {
              title: "Children's Book Artwork",
              desc: "Whimsical, colorful, full-spread digital and hand-painted storybook illustrations.",
            },
            {
              title: "Concept Art & Character Design",
              desc: "Sci-Fi, Fantasy, world-building lore, creature design, and digital art portfolios.",
            },
            {
              title: "Coffee Table & Fine Art Books",
              desc: "Luxury photo art collections, painter portfolios, and architectural monographs.",
            },
            {
              title: "Digital Book Cover Illustration",
              desc: "Custom cover paintings designed for instant genre recognition on digital platforms.",
            },
            {
              title: "Vector & Infographic Design",
              desc: "Clean technical diagrams, instructional art, educational graphics, and iconography.",
            },
            {
              title: "Colouring & Line Art Books",
              desc: "Intricate mandala designs, animal line art, and adult relaxation colouring workbooks.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/60 border border-white/15 p-6 sm:p-7 hover:border-[#3075ba] transition-colors">
              <div class="text-[#3075ba] font-bold text-xs uppercase tracking-widest mb-2">
                Medium #{idx + 1}
              </div>
              <h3 class="font-extrabold text-base sm:text-lg text-white uppercase mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 5: Print & Color Proofing Roadmap */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/art-and-illustrations/section-5.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            ATELIER PRODUCTION PROCESS
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            THE ART PUBLISHING ROADMAP
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            {
              step: "PHASE 01",
              title: "Visual Storyboarding",
              desc: "Translating script notes into visual thumbnails, composition sketches, and color keys.",
            },
            {
              step: "PHASE 02",
              title: "High-Res Art Rendering",
              desc: "Final digital painting, line art refinement, character polish, and high-DPI art generation.",
            },
            {
              step: "PHASE 03",
              title: "Color Proofing & Bleeds",
              desc: "Harmonizing typography with artwork, adjusting margins, bleeds, and CMYK color profiles.",
            },
            {
              step: "PHASE 04",
              title: "Gallery Hardcover Press",
              desc: "Hardcover press runs, foil finishes, eBook conversion, and global distribution.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/65 border border-white/20 p-6 relative group hover:border-[#3075ba] transition-colors">
              <span class="text-[10px] font-extrabold text-[#3075ba] uppercase tracking-widest block mb-2">
                {item.step}
              </span>
              <h3 class="font-extrabold text-base text-white uppercase mb-3">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 6: Studio Atelier CTA */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-b border-[#3075ba]/40"
      style="background-image: url('/images/genre/art-and-illustrations/section-6.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-slate-950/70 to-black/80 pointer-events-none"></div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-3">
          PUBLISH YOUR ARTWORK WITH DISTINCTION
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-white mb-6">
          READY TO BRING YOUR VISUALS TO PRINT?
        </h2>
        <p class="text-sm sm:text-base text-gray-200 max-w-2xl mx-auto mb-8 leading-relaxed">
          Schedule a consultation with our art directors and illustration team to receive a free portfolio review and publishing proposal.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-xs uppercase tracking-widest hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
          >
            <span>Request Portfolio Review</span>
          </a>
          <a
            href="/packages"
            class="h-12 px-8 bg-black/50 text-white font-bold text-xs uppercase tracking-widest border border-white/40 hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>View Art Packages</span>
          </a>
        </div>
      </div>
    </section>

    <EverythingSection client:load />
    <Footer />
  </div>
</Layout>
