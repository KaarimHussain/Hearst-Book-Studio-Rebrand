---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import ChildrenBookShowcase from "../../components/ChildrenBookShowcase.tsx";
import EverythingSection from "../../components/EverythingSection.tsx";
import Footer from "../../components/Footer.astro";
---

<Layout title="Children's Book Publishing — Hearst Book Studio">
  <div class="relative bg-black text-white">
    <Navbar client:load />

    {/* SECTION 1: Playful Hero */}
    <section
      class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 bg-cover bg-center bg-no-repeat overflow-hidden"
      style="background-image: url('/images/genre/children-book/section-1.png');"
    >
      <div
        class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70 pointer-events-none"
      >
      </div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        {/* Playful Floating Badges */}
        <div class="flex flex-wrap items-center justify-center gap-3 mb-6">
          <span
            class="bg-[#3075ba] text-white text-xs font-black uppercase tracking-wider px-3.5 py-1.5 rounded-full shadow-lg border border-white/20"
          >
            🎨 Full-Spread Illustration
          </span>
          <span
            class="bg-amber-500 text-black text-xs font-black uppercase tracking-wider px-3.5 py-1.5 rounded-full shadow-lg"
          >
            👶 Ages 0 - 12+
          </span>
          <span
            class="bg-emerald-500 text-black text-xs font-black uppercase tracking-wider px-3.5 py-1.5 rounded-full shadow-lg"
          >
            📚 Picture Books & Graphic Novels
          </span>
        </div>

        <h1
          class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-white leading-none mb-6 drop-shadow-2xl"
        >
          BRINGING MAGIC TO <br />
          <span
            class="text-white underline decoration-amber-400 decoration-wavy underline-offset-8"
            >LITTLE READERS</span
          >
        </h1>

        <p
          class="text-base sm:text-lg md:text-xl text-gray-100 font-medium max-w-3xl mx-auto leading-relaxed mb-8 sm:mb-10 drop-shadow-md"
        >
          From whimsical picture books and vibrant character designs to early
          reader chapter books, we turn magical bedtime stories into beautifully
          published hardcovers children cherish forever.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="#children-showcase"
            class="h-13 px-8 bg-[#3075ba] hover:bg-[#2560a0] text-white font-black text-sm uppercase tracking-wider rounded-full transition-all transform hover:scale-105 inline-flex items-center gap-2 shadow-2xl border border-white/20"
          >
            <span>Explore Children's Books</span>
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
          <a
            href="/contact"
            class="h-13 px-8 bg-amber-500 hover:bg-amber-400 text-black font-black text-sm uppercase tracking-wider rounded-full transition-all transform hover:scale-105 inline-flex items-center gap-2 shadow-2xl"
          >
            <span>Publish Your Storybook</span>
          </a>
        </div>
      </div>
    </section>

    {/* SECTION 2: Age Group Feature Grid (Unique Layout) */}
    <section
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/children-book/section-2.png');"
    >
      <div class="absolute inset-0 bg-black/60 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span
            class="text-xs font-black uppercase tracking-widest text-amber-400 bg-amber-400/10 px-4 py-1.5 rounded-full border border-amber-400/30 inline-block mb-3"
          >
            TAILORED FOR EVERY READING STAGE
          </span>
          <h2
            class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white drop-shadow-md"
          >
            WHAT WE SPECIALIZE IN
          </h2>
        </div>

        {/* 4 Rounded Cards with Age Pills */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            [
              {
                age: "Ages 0 - 3",
                title: "Board Books & Touch-and-Feel",
                desc: "Durable thick-page board books with high-contrast colors, sensory textures, and simple words for toddlers.",
                color: "border-pink-500/50 bg-pink-950/40",
                tagBg: "bg-pink-500 text-white",
              },
              {
                age: "Ages 3 - 7",
                title: "Illustrated Picture Books",
                desc: "Full 32-page illustrated spreads, rhyming bedtime tales, and memorable animal characters.",
                color: "border-[#3075ba]/50 bg-blue-950/40",
                tagBg: "bg-[#3075ba] text-white",
              },
              {
                age: "Ages 6 - 9",
                title: "Early Reader Chapter Books",
                desc: "Large font sizes, frequent illustrations, short chapter lengths, and engaging early reader vocabulary.",
                color: "border-amber-500/50 bg-amber-950/40",
                tagBg: "bg-amber-500 text-black",
              },
              {
                age: "Ages 8 - 12+",
                title: "Kids Graphic Novels",
                desc: "Action-packed multi-panel graphic novels, humor series, comic strips, and middle-grade adventures.",
                color: "border-emerald-500/50 bg-emerald-950/40",
                tagBg: "bg-emerald-500 text-black",
              },
            ].map((item, idx) => (
              <div
                key={idx}
                class={`rounded-3xl border-2 p-6 sm:p-7 backdrop-blur-none flex flex-col justify-between transition-transform duration-300 hover:-translate-y-2 ${item.color}`}
              >
                <div>
                  <span
                    class={`inline-block text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full mb-4 shadow-md ${item.tagBg}`}
                  >
                    {item.age}
                  </span>
                  <h3 class="font-black text-xl text-white uppercase mb-3 leading-snug">
                    {item.title}
                  </h3>
                  <p class="text-xs text-gray-200 leading-relaxed font-medium">
                    {item.desc}
                  </p>
                </div>
                <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs text-gray-300 font-bold">
                  <span>Standard 32-Page Layout</span>
                  <span class="text-amber-400">★ ★ ★ ★ ★</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* SECTION 3: Interactive Showcase */}
    <section
      id="children-showcase"
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/children-book/section-3.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
          <span
            class="text-xs font-black uppercase tracking-widest text-[#3075ba] bg-[#3075ba]/20 px-4 py-1.5 rounded-full border border-[#3075ba]/40 inline-block mb-3"
          >
            GALLERY OF YOUNG READERS' FAVORITES
          </span>
          <h2
            class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white drop-shadow-md"
          >
            EXPLORE CHILDREN'S BOOK PORTFOLIO
          </h2>
          <p class="text-xs sm:text-sm text-gray-200 mt-3 font-medium">
            Filter through picture books, activity workbooks, and graphic novels
            published by Hearst Book Studio.
          </p>
        </div>

        <ChildrenBookShowcase client:load />
      </div>
    </section>

    {
      /* SECTION 4: Illustrative Quality Guarantee (2x2 Asymmetric Unique Grid) */
    }
    <section
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/children-book/section-4.png');"
    >
      <div
        class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/75 pointer-events-none"
      >
      </div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div
          class="flex flex-col lg:flex-row items-center justify-between gap-12"
        >
          {/* Left Column: Big Headline Box */}
          <div
            class="w-full lg:w-5/12 bg-black/70 border-2 border-[#3075ba]/60 p-8 sm:p-10 rounded-3xl"
          >
            <span
              class="text-xs font-black uppercase tracking-widest text-amber-400 block mb-2"
            >
              WHY AUTHORS TRUST US
            </span>
            <h2
              class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white leading-tight mb-4"
            >
              PERFECT COLOR ACCURACY & CHILD SAFETY STANDARDS
            </h2>
            <p
              class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal mb-6"
            >
              Children’s books require precise paper weight, non-toxic inks,
              durable binding, and vibrant CMYK color matching. We ensure every
              page looks stunning in little hands.
            </p>
            <div
              class="flex items-center gap-4 text-xs font-bold text-amber-300 bg-amber-400/10 p-3.5 rounded-2xl border border-amber-400/30"
            >
              <span class="text-2xl">✨</span>
              <span>100% Custom Character Concept Art Included</span>
            </div>
          </div>

          {/* Right Column: 2x2 Feature Badges */}
          <div class="w-full lg:w-7/12 grid grid-cols-1 sm:grid-cols-2 gap-6">
            {
              [
                {
                  title: "Custom Illustrator Match",
                  desc: "We pair your story with world-class children's book illustrators specializing in watercolor, digital 2D/3D, or vector art styles.",
                  icon: "🎨",
                },
                {
                  title: "Professional Storyboarding",
                  desc: "Every 32-page layout is carefully panel-mapped to balance text and full-spread illustrations for perfect pacing.",
                  icon: "📐",
                },
                {
                  title: "Hardcover & Board Book Print",
                  desc: "Heavy-duty paper stock options, gloss/matte lamination, and child-safe rounded corner finishes.",
                  icon: "📖",
                },
                {
                  title: "Global Distribution & Audio",
                  desc: "Instant listing on Amazon, Barnes & Noble, IngramSpark, plus character-narrated audiobooks with background music.",
                  icon: "🎧",
                },
              ].map((box, idx) => (
                <div
                  key={idx}
                  class="bg-black/65 border border-white/20 p-6 rounded-2xl hover:border-amber-400 transition-colors"
                >
                  <div class="text-3xl mb-3">{box.icon}</div>
                  <h3 class="font-black text-base text-white uppercase mb-2">
                    {box.title}
                  </h3>
                  <p class="text-xs text-gray-200 leading-relaxed">
                    {box.desc}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 5: Playful Step-by-Step Creation Roadmap */}
    <section
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/children-book/section-5.png');"
    >
      <div class="absolute inset-0 bg-black/60 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span
            class="text-xs font-black uppercase tracking-widest text-[#3075ba] bg-[#3075ba]/20 px-4 py-1.5 rounded-full border border-[#3075ba]/40 inline-block mb-3"
          >
            FROM IDEA TO ILLUSTATED BOOK
          </span>
          <h2
            class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white drop-shadow-md"
          >
            4-STEP STORYBOOK JOURNEY
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            [
              {
                step: "STEP 1",
                title: "Manuscript Editing",
                desc: "Refining rhyming meter, word choice, and story arc for target age comprehension.",
                icon: "📝",
              },
              {
                step: "STEP 2",
                title: "Character Design",
                desc: "Sketching main characters, color palettes, and emotions for author approval.",
                icon: "🖌️",
              },
              {
                step: "STEP 3",
                title: "32-Page Art Spread",
                desc: "Rendering high-resolution full-spread digital illustrations with embedded text layout.",
                icon: "🖼️",
              },
              {
                step: "STEP 4",
                title: "Hardcover Print & Launch",
                desc: "Printing sample proofs, publishing on Amazon, and launching marketing promos.",
                icon: "🚀",
              },
            ].map((item, idx) => (
              <div
                key={idx}
                class="bg-black/70 border-2 border-white/20 rounded-3xl p-6 relative hover:border-[#3075ba] transition-all"
              >
                <div class="flex items-center justify-between mb-4">
                  <span class="text-[10px] font-black text-amber-400 uppercase tracking-widest bg-amber-400/10 px-3 py-1 rounded-full border border-amber-400/30">
                    {item.step}
                  </span>
                  <span class="text-2xl">{item.icon}</span>
                </div>
                <h3 class="font-black text-lg text-white uppercase mb-2">
                  {item.title}
                </h3>
                <p class="text-xs text-gray-200 leading-relaxed font-normal">
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* SECTION 6: Playful CTA Banner */}
    <section
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-b border-[#3075ba]/40"
      style="background-image: url('/images/genre/children-book/section-6.png');"
    >
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/80 via-blue-950/70 to-black/80 pointer-events-none"
      >
      </div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <span
          class="text-xs font-black uppercase tracking-widest text-amber-400 bg-amber-400/10 px-4 py-1.5 rounded-full border border-amber-400/30 inline-block mb-4"
        >
          YOUR STORYBOOK DREAM STARTS HERE
        </span>
        <h2
          class="text-3xl sm:text-5xl lg:text-6xl font-black uppercase tracking-tight text-white mb-6 drop-shadow-md"
        >
          READY TO ILLUMINATE A CHILD'S IMAGINATION?
        </h2>
        <p
          class="text-sm sm:text-base text-gray-100 max-w-2xl mx-auto mb-8 leading-relaxed font-medium"
        >
          Get a free consultation with our children's book editorial directors
          and illustration team.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="h-13 px-8 bg-[#3075ba] hover:bg-[#2560a0] text-white font-black text-sm uppercase tracking-wider rounded-full transition-all transform hover:scale-105 inline-flex items-center gap-2 shadow-2xl border border-white/20"
          >
            <span>Request Free Story Consultation</span>
          </a>
          <a
            href="/packages"
            class="h-13 px-8 bg-amber-500 hover:bg-amber-400 text-black font-black text-sm uppercase tracking-wider rounded-full transition-all transform hover:scale-105 inline-flex items-center gap-2 shadow-2xl"
          >
            <span>View Children's Packages</span>
          </a>
        </div>
      </div>
    </section>

    <EverythingSection client:load />
    <Footer />
  </div>
</Layout>
