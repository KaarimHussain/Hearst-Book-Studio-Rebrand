---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import InspirationalShowcase from "../../components/InspirationalShowcase.tsx";
import EverythingSection from "../../components/EverythingSection.tsx";
import Footer from "../../components/Footer.astro";
---

<Layout title="Inspirational Publishing — Hearst Book Studio">
  <div class="relative bg-black text-white">
    <Navbar client:load />

    {/* SECTION 1: Radiant Inspirational Hero */}
    <section 
      class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 bg-cover bg-center bg-no-repeat overflow-hidden"
      style="background-image: url('/images/genre/inspirational/section-1.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/45 to-black/75 pointer-events-none"></div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-[#3075ba]/30 border border-[#3075ba]/60 px-4 py-1.5 mb-6">
          <span class="text-xs font-bold uppercase tracking-widest text-white">
            ✨ INSPIRATIONAL PUBLISHING STUDIO
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-7xl font-extrabold uppercase tracking-tight text-white leading-tight mb-6 drop-shadow-xl">
          STORIES OF HOPE, PURPOSE & <span class="text-[#3075ba] italic font-serif">transformation</span>
        </h1>

        <p class="text-sm sm:text-base md:text-lg text-gray-100 font-medium max-w-3xl mx-auto leading-relaxed mb-8 sm:mb-10 drop-shadow-md">
          From uplifting personal testimonies and daily motivational devotionals to transformative mindset books, Hearst Book Studio amplifies messages that ignite the human spirit.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="#inspirational-showcase"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-xs uppercase tracking-widest hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
          >
            <span>Explore Inspirational Titles</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="/contact"
            class="h-12 px-8 bg-black/50 text-white font-bold text-xs uppercase tracking-widest border border-white/40 hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>Publish Your Message</span>
          </a>
        </div>
      </div>
    </section>

    {/* SECTION 2: Heart-Centered Pillars */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/inspirational/section-2.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            HEART-CENTERED PUBLISHING
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            AMPLIFYING MESSAGES THAT MATTER
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          <div class="bg-black/75 border border-[#3075ba]/40 p-6 sm:p-8 hover:border-[#3075ba] transition-colors relative shadow-[0_0_20px_rgba(48,117,186,0.15)]">
            <div class="text-xs font-bold text-[#3075ba] uppercase tracking-widest mb-3 font-serif">
              — Pillar 01 —
            </div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Empathetic Story Editing
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Senior editors work directly with authors to draw out deep emotional truth, overcoming-adversity themes, and uplifting life lessons.
            </p>
          </div>

          <div class="bg-black/75 border border-[#3075ba]/40 p-6 sm:p-8 hover:border-[#3075ba] transition-colors relative shadow-[0_0_20px_rgba(48,117,186,0.15)]">
            <div class="text-xs font-bold text-[#3075ba] uppercase tracking-widest mb-3 font-serif">
              — Pillar 02 —
            </div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Elegant Gift & Devotional Layout
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Custom ribbon bookmarks, gilded edges, daily reflection typography, and serene interior design choices.
            </p>
          </div>

          <div class="bg-black/75 border border-[#3075ba]/40 p-6 sm:p-8 hover:border-[#3075ba] transition-colors relative shadow-[0_0_20px_rgba(48,117,186,0.15)]">
            <div class="text-xs font-bold text-[#3075ba] uppercase tracking-widest mb-3 font-serif">
              — Pillar 03 —
            </div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Global Inspirational Release
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Worldwide distribution across major online retailers, specialty gift stores, non-profits, and audio platforms.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 3: Showcase */}
    <section 
      id="inspirational-showcase"
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/inspirational/section-3.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            INSPIRATIONAL CATALOGUE
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            EXPLORE PUBLISHED INSPIRATIONAL BOOKS
          </h2>
          <p class="text-xs sm:text-sm text-gray-200 mt-3 font-medium">
            Search motivational books, devotionals, and transformation stories.
          </p>
        </div>

        <InspirationalShowcase client:load />
      </div>
    </section>

    {/* SECTION 4: Sub-Categories */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/inspirational/section-4.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/50 to-black/70 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            INSPIRATIONAL CATEGORIES
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            INSPIRATIONAL DOMAINS WE PUBLISH
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            {
              title: "Triumph & Resilience Stories",
              desc: "True stories of overcoming illness, tragedy, addiction, and insurmountable odds.",
            },
            {
              title: "Daily Motivation & Devotionals",
              desc: "365-day reflection journals, daily morning thoughts, and spiritual encouragement.",
            },
            {
              title: "Purpose & Life Calling Guides",
              desc: "Discovering career calling, personal mission statements, and living intentionally.",
            },
            {
              title: "Mindfulness & Inner Peace",
              desc: "Gratitude journals, quiet contemplation practices, and stress reduction wisdom.",
            },
            {
              title: "Faith-Based Inspirational Stories",
              desc: "Uplifting Christian, interfaith, and spiritual journey memoirs and teachings.",
            },
            {
              title: "Gift & Celebration Books",
              desc: "Elegantly formatted milestone gift books for graduations, weddings, and anniversaries.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/60 border border-white/15 p-6 sm:p-7 hover:border-[#3075ba] transition-colors">
              <div class="text-[#3075ba] font-bold text-xs uppercase tracking-widest mb-2 font-serif">
                Category #{idx + 1}
              </div>
              <h3 class="font-extrabold text-base sm:text-lg text-white uppercase mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 5: Roadmap */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/inspirational/section-5.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            4-STEP INSPIRATIONAL ROADMAP
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            THE INSPIRATIONAL PUBLISHING ROADMAP
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            {
              step: "PHASE 01",
              title: "Story Outline & Theme",
              desc: "Identifying core inspirational takeaways and structuring your personal narrative.",
            },
            {
              step: "PHASE 02",
              title: "Editorial Refinement",
              desc: "Deep line editing, tone polishing, and quote integration.",
            },
            {
              step: "PHASE 03",
              title: "Serene Interior Design",
              desc: "Elegantly spaced typography, custom chapter head graphics, and cover branding.",
            },
            {
              step: "PHASE 04",
              title: "Global Distribution",
              desc: "Hardcover, Paperback, eBook, and Audiobook release across major worldwide platforms.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/65 border border-white/20 p-6 relative group hover:border-[#3075ba] transition-colors">
              <span class="text-[10px] font-extrabold text-[#3075ba] uppercase tracking-widest block mb-2">
                {item.step}
              </span>
              <h3 class="font-extrabold text-base text-white uppercase mb-3">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 6: CTA */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-b border-[#3075ba]/40"
      style="background-image: url('/images/genre/inspirational/section-6.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-slate-950/70 to-black/80 pointer-events-none"></div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-3 font-serif">
          Share Your Inspiration with the World
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-white mb-6">
          READY TO PUBLISH YOUR INSPIRATIONAL BOOK?
        </h2>
        <p class="text-sm sm:text-base text-gray-200 max-w-2xl mx-auto mb-8 leading-relaxed">
          Speak with our editorial directors to receive a free manuscript review and tailored publishing proposal.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-xs uppercase tracking-widest hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
          >
            <span>Request Free Manuscript Review</span>
          </a>
          <a
            href="/packages"
            class="h-12 px-8 bg-black/50 text-white font-bold text-xs uppercase tracking-widest border border-white/40 hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>View Publishing Packages</span>
          </a>
        </div>
      </div>
    </section>

    <EverythingSection client:load />
    <Footer />
  </div>
</Layout>
