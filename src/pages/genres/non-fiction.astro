---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import NonFictionShowcase from "../../components/NonFictionShowcase.tsx";
import EverythingSection from "../../components/EverythingSection.tsx";
import Footer from "../../components/Footer.astro";
---

<Layout title="Non-Fiction Publishing — Hearst Book Studio">
  <div class="relative bg-black text-white">
    <Navbar client:load />

    {/* SECTION 1: Authoritative Editorial Hero */}
    <section 
      class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 bg-cover bg-center bg-no-repeat overflow-hidden"
      style="background-image: url('/images/genre/non-fiction/section-1.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/50 to-black/80 pointer-events-none"></div>

      <div class="relative z-10 max-w-6xl mx-auto">
        <div class="text-left max-w-3xl mb-10">
          <div class="inline-flex items-center gap-2 bg-[#3075ba]/20 border border-[#3075ba]/50 px-4 py-1.5 mb-6">
            <span class="w-2 h-2 bg-[#3075ba]"></span>
            <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba]">
              NON-FICTION & SCHOLARLY PUBLISHING
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold uppercase tracking-tight text-white leading-tight mb-6 drop-shadow-xl">
            FACTUAL RIGOR, RESEARCH & <span class="text-[#3075ba]">EDITORIAL AUTHORITY</span>
          </h1>

          <p class="text-sm sm:text-base md:text-lg text-gray-100 font-medium leading-relaxed mb-8 drop-shadow-md">
            From investigative journalism and historical accounts to scientific studies, memoirs, and political commentary, Hearst Book Studio turns research into landmark non-fiction literature.
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <a
              href="#non-fiction-showcase"
              class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-xs uppercase tracking-widest hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
            >
              <span>Explore Non-Fiction Books</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <a
              href="/contact"
              class="h-12 px-8 bg-white/10 text-white font-bold text-xs uppercase tracking-widest border border-white/30 hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
            >
              <span>Submit Manuscript Proposal</span>
            </a>
          </div>
        </div>

        {/* Analytical Ticker Bar */}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8 pt-8 border-t border-white/15 bg-black/60 p-5 border border-white/10">
          <div class="border-r border-white/10 last:border-0 pr-4">
            <div class="text-xl font-bold text-[#3075ba]">100% Fact-Checked</div>
            <div class="text-[10px] text-gray-300 font-medium uppercase tracking-wider mt-1">Citation Verification</div>
          </div>
          <div class="border-r border-white/10 last:border-0 pr-4">
            <div class="text-xl font-bold text-[#3075ba]">Peer Reviewed</div>
            <div class="text-[10px] text-gray-300 font-medium uppercase tracking-wider mt-1">Editorial Quality</div>
          </div>
          <div class="border-r border-white/10 last:border-0 pr-4">
            <div class="text-xl font-bold text-[#3075ba]">Global Indexing</div>
            <div class="text-[10px] text-gray-300 font-medium uppercase tracking-wider mt-1">Library & Retail Access</div>
          </div>
          <div>
            <div class="text-xl font-bold text-[#3075ba]">Index & Citations</div>
            <div class="text-[10px] text-gray-300 font-medium uppercase tracking-wider mt-1">Full Footnote Support</div>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 2: Research & Analytical Pillars */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/non-fiction/section-2.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            RESEARCH & EDITORIAL STANDARDS
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            RIGOROUS NON-FICTION PUBLISHING
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          <div class="bg-black/75 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors group">
            <div class="text-xs font-bold text-[#3075ba] uppercase tracking-widest mb-3 font-mono">
              [STANDARD 01]
            </div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Fact-Checking & Citation Indexing
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Thorough verification of historical dates, scientific references, interview transcripts, footnotes, and bibliographic citations.
            </p>
          </div>

          <div class="bg-black/75 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors group">
            <div class="text-xs font-bold text-[#3075ba] uppercase tracking-widest mb-3 font-mono">
              [STANDARD 02]
            </div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Data & Infographic Vectorization
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Converting complex data sets into clean charts, geographical maps, timelines, and analytical diagrams for print.
            </p>
          </div>

          <div class="bg-black/75 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors group">
            <div class="text-xs font-bold text-[#3075ba] uppercase tracking-widest mb-3 font-mono">
              [STANDARD 03]
            </div>
            <h3 class="font-extrabold text-xl text-white uppercase mb-3">
              Academic & Retail Distribution
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Listing across university libraries, academic distributors, Amazon, IngramSpark, and major retail bookstore chains.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 3: Showcase */}
    <section 
      id="non-fiction-showcase"
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/non-fiction/section-3.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            NON-FICTION CATALOGUE
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            EXPLORE PUBLISHED NON-FICTION BOOKS
          </h2>
          <p class="text-xs sm:text-sm text-gray-200 mt-3 font-medium">
            Search history, business, self-help, and technology works.
          </p>
        </div>

        <NonFictionShowcase client:load />
      </div>
    </section>

    {/* SECTION 4: Subject Areas */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/non-fiction/section-4.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/50 to-black/70 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            NON-FICTION SUBJECT AREAS
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            SUBJECTS WE PUBLISH
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            {
              title: "History & Historical Accounts",
              desc: "Deeply researched historical narratives, military histories, world events, and archives.",
            },
            {
              title: "Science, Tech & Environment",
              desc: "Pop-science books, environmental studies, AI technology, and space exploration works.",
            },
            {
              title: "Politics, Society & Current Affairs",
              desc: "Sociological analyses, geopolitical studies, public policy books, and investigative journalism.",
            },
            {
              title: "True Crime & Investigative Journalism",
              desc: "Exhaustive true crime accounts, court case breakdowns, and investigative exposés.",
            },
            {
              title: "Philosophy, Psychology & Ethics",
              desc: "Cognitive psychology, moral philosophy, behavioral economics, and human behavior.",
            },
            {
              title: "Memoir & Narrative Non-Fiction",
              desc: "Personal memoirs written with journalistic accuracy and compelling storytelling.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/60 border border-white/15 p-6 sm:p-7 hover:border-[#3075ba] transition-colors">
              <div class="text-[#3075ba] font-bold text-xs uppercase tracking-widest mb-2 font-mono">
                Subject #{idx + 1}
              </div>
              <h3 class="font-extrabold text-base sm:text-lg text-white uppercase mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 5: Research Roadmap */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/non-fiction/section-5.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            4-STEP EDITORIAL AUDIT
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            THE NON-FICTION PUBLISHING ROADMAP
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            {
              step: "PHASE 01",
              title: "Manuscript Proposal",
              desc: "Auditing non-fiction proposals, outline structures, target audience, and competitive titles.",
            },
            {
              step: "PHASE 02",
              title: "Fact-Check & Editing",
              desc: "Verifying dates, references, footnotes, and performing deep developmental editing.",
            },
            {
              step: "PHASE 03",
              title: "Typesetting & Indexing",
              desc: "Designing authoritative cover artwork, clean body text typesetting, and subject index creation.",
            },
            {
              step: "PHASE 04",
              title: "Global Distribution",
              desc: "Releasing across Amazon, IngramSpark, Barnes & Noble, and academic distribution channels.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/65 border border-white/20 p-6 relative group hover:border-[#3075ba] transition-colors">
              <span class="text-[10px] font-extrabold text-[#3075ba] uppercase tracking-widest block mb-2">
                {item.step}
              </span>
              <h3 class="font-extrabold text-base text-white uppercase mb-3">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 6: Editorial CTA */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-b border-[#3075ba]/40"
      style="background-image: url('/images/genre/non-fiction/section-6.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-slate-950/70 to-black/80 pointer-events-none"></div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-3">
          PUBLISH YOUR RESEARCH & KNOWLEDGE WORLDWIDE
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-white mb-6">
          READY TO PUBLISH YOUR NON-FICTION BOOK?
        </h2>
        <p class="text-sm sm:text-base text-gray-200 max-w-2xl mx-auto mb-8 leading-relaxed">
          Speak with our senior non-fiction editors to receive a free manuscript review and publication roadmap.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-xs uppercase tracking-widest hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
          >
            <span>Request Free Manuscript Review</span>
          </a>
          <a
            href="/packages"
            class="h-12 px-8 bg-white/10 text-white font-bold text-xs uppercase tracking-widest border border-white/30 hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>View Non-Fiction Packages</span>
          </a>
        </div>
      </div>
    </section>

    <EverythingSection client:load />
    <Footer />
  </div>
</Layout>
