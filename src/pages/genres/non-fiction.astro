---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import NonFictionShowcase from "../../components/NonFictionShowcase.tsx";
import EverythingSection from "../../components/EverythingSection.tsx";
import Footer from "../../components/Footer.astro";
---

<Layout title="Non-Fiction Publishing — Hearst Book Studio">
  <div class="relative bg-black text-white">
    <Navbar client:load />

    {/* SECTION 1: Hero Cover Section */}
    <section 
      class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 bg-cover bg-center bg-no-repeat overflow-hidden"
      style="background-image: url('/images/genre/non-fiction/section-1.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/45 to-black/65 pointer-events-none"></div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-[#3075ba]/30 border border-[#3075ba]/50 px-4 py-1.5 mb-6">
          <span class="w-2 h-2 rounded-full bg-[#3075ba]"></span>
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba]">
            NON-FICTION & EXPERT PUBLISHING
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold uppercase tracking-tight text-white leading-tight mb-6 drop-shadow-xl">
          TRANSFORM REAL KNOWLEDGE INTO <span class="text-[#3075ba]">AUTHORITATIVE BOOKS</span>
        </h1>

        <p class="text-sm sm:text-base md:text-lg text-gray-100 font-medium max-w-3xl mx-auto leading-relaxed mb-8 sm:mb-10 drop-shadow-md">
          From executive business guides and memoirs to self-improvement bestsellers and technical manuals, Hearst Book Studio transforms expert knowledge into polished, market-ready non-fiction publications.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="#non-fiction-showcase"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-sm uppercase tracking-wider hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
          >
            <span>Explore Non-Fiction Catalogue</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="/contact"
            class="h-12 px-8 bg-black/40 text-white font-bold text-sm uppercase tracking-wider border-2 border-white hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>Publish Your Work</span>
          </a>
        </div>
      </div>
    </section>

    {/* SECTION 2: Non-Fiction Pillars */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/non-fiction/section-2.png');"
    >
      <div class="absolute inset-0 bg-black/50 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2 drop-shadow-sm">
            PRECISION & FACTUAL INTEGRITY
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white drop-shadow-md">
            ENGINEERED FOR AUTHORITY & IMPACT
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          <div class="bg-black/65 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors group">
            <div class="w-12 h-12 bg-[#3075ba]/30 border border-[#3075ba]/60 flex items-center justify-center text-[#3075ba] font-bold text-lg mb-6 group-hover:bg-[#3075ba] group-hover:text-white transition-colors">
              01
            </div>
            <h3 class="font-extrabold text-lg text-white uppercase mb-3">
              Ghostwriting & Research Synthesis
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Collaborate with expert non-fiction ghostwriters to translate your ideas, interviews, and corporate data into a cohesive, articulate book draft.
            </p>
          </div>

          <div class="bg-black/65 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors group">
            <div class="w-12 h-12 bg-[#3075ba]/30 border border-[#3075ba]/60 flex items-center justify-center text-[#3075ba] font-bold text-lg mb-6 group-hover:bg-[#3075ba] group-hover:text-white transition-colors">
              02
            </div>
            <h3 class="font-extrabold text-lg text-white uppercase mb-3">
              Fact-Checking & Citation Verification
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Rigorous editorial proofing, citation cross-checking, footnote formatting, and index generation for academic, corporate, and historical manuscripts.
            </p>
          </div>

          <div class="bg-black/65 border border-white/20 p-6 sm:p-8 hover:border-[#3075ba] transition-colors group">
            <div class="w-12 h-12 bg-[#3075ba]/30 border border-[#3075ba]/60 flex items-center justify-center text-[#3075ba] font-bold text-lg mb-6 group-hover:bg-[#3075ba] group-hover:text-white transition-colors">
              03
            </div>
            <h3 class="font-extrabold text-lg text-white uppercase mb-3">
              Thought Leadership Positioning
            </h3>
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              Strategic distribution designed to position authors as industry leaders, keynote speakers, and subject matter experts in business and media.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 3: Curated Non-Fiction Portfolio Showcase */}
    <section 
      id="non-fiction-showcase"
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/non-fiction/section-3.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2 drop-shadow-sm">
            OUR FEATURED NON-FICTION CATALOGUE
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white drop-shadow-md">
            EXPLORE PUBLISHED NON-FICTION TITLES
          </h2>
          <p class="text-xs sm:text-sm text-gray-200 mt-3 font-medium">
            Browse our curated showcase of business, self-help, technology, and leadership titles.
          </p>
        </div>

        <NonFictionShowcase client:load />
      </div>
    </section>

    {/* SECTION 4: Sub-Categories Specialization */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/non-fiction/section-4.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/50 to-black/70 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2 drop-shadow-sm">
            SUBJECT MATTER EXPERTISE
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white drop-shadow-md">
            NON-FICTION DOMAINS WE SPECIALIZE IN
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            {
              title: "Business, Strategy & Startups",
              desc: "Corporate management, entrepreneurial frameworks, venture strategy, and economic leadership.",
            },
            {
              title: "Self-Help & Personal Growth",
              desc: "Habit formation, mental health, productivity systems, mindfulness, and personal finance.",
            },
            {
              title: "Technology & Computer Science",
              desc: "Software architecture, AI, data infrastructure, programming guides, and tech innovation.",
            },
            {
              title: "Memoirs & Autobiographies",
              desc: "Authentic personal narratives, executive memoirs, historical recollections, and inspiring life stories.",
            },
            {
              title: "Health, Wellness & Science",
              desc: "Evidence-based health guides, medical science, nutrition, and psychology publications.",
            },
            {
              title: "History, Politics & Culture",
              desc: "In-depth historical analysis, political commentary, cultural studies, and investigative journalism.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/60 border border-white/15 p-6 sm:p-7 hover:border-[#3075ba] transition-colors">
              <div class="text-[#3075ba] font-bold text-xs uppercase tracking-widest mb-2">
                Domain #{idx + 1}
              </div>
              <h3 class="font-extrabold text-base sm:text-lg text-white uppercase mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 5: Publishing Roadmap */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-white/10"
      style="background-image: url('/images/genre/non-fiction/section-5.png');"
    >
      <div class="absolute inset-0 bg-black/55 pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2 drop-shadow-sm">
            EXECUTIVE PUBLISHING PROCESS
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white drop-shadow-md">
            THE NON-FICTION AUTHOR ROADMAP
          </h2>
          <div class="w-16 h-1 bg-[#3075ba] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            {
              step: "PHASE 01",
              title: "Outline & Ghostwriting",
              desc: "Structuring chapter outlines, conducting author interviews, or polishing raw draft materials.",
            },
            {
              step: "PHASE 02",
              title: "Editorial & Fact-Check",
              desc: "Comprehensive line editing, technical accuracy verification, citations, and index creation.",
            },
            {
              step: "PHASE 03",
              title: "Executive Interior Design",
              desc: "Clean interior typography, charts, callouts, tables, and professional cover branding.",
            },
            {
              step: "PHASE 04",
              title: "Distribution & Launch",
              desc: "Global Amazon, IngramSpark, and bookstore distribution with press release support.",
            },
          ].map((item, idx) => (
            <div key={idx} class="bg-black/65 border border-white/20 p-6 relative group hover:border-[#3075ba] transition-colors">
              <span class="text-[10px] font-extrabold text-[#3075ba] uppercase tracking-widest block mb-2">
                {item.step}
              </span>
              <h3 class="font-extrabold text-base text-white uppercase mb-3">
                {item.title}
              </h3>
              <p class="text-xs text-gray-200 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 6: Author Call-To-Action Banner */}
    <section 
      class="relative py-16 sm:py-24 px-4 sm:px-6 bg-cover bg-center bg-no-repeat border-t border-b border-[#3075ba]/40"
      style="background-image: url('/images/genre/non-fiction/section-6.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-slate-950/60 to-black/70 pointer-events-none"></div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-3 drop-shadow-sm">
          PUBLISH YOUR KNOWLEDGE TODAY
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-white mb-6 drop-shadow-md">
          READY TO BECOME A PUBLISHED THOUGHT LEADER?
        </h2>
        <p class="text-sm sm:text-base text-gray-200 max-w-2xl mx-auto mb-8 leading-relaxed">
          Schedule a consultation with our non-fiction publishing strategists to receive a free manuscript review and tailored publishing proposal.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="h-12 px-8 bg-[#3075ba] text-white font-extrabold text-sm uppercase tracking-wider hover:bg-[#2560a0] transition-colors inline-flex items-center gap-2 shadow-xl"
          >
            <span>Request Free Manuscript Review</span>
          </a>
          <a
            href="/packages"
            class="h-12 px-8 bg-black/40 text-white font-bold text-sm uppercase tracking-wider border-2 border-white hover:bg-white hover:text-black transition-colors inline-flex items-center gap-2"
          >
            <span>Explore Publishing Packages</span>
          </a>
        </div>
      </div>
    </section>

    <EverythingSection client:load />
    <Footer />
  </div>
</Layout>
