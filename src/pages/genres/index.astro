---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import GenresOverviewGrid from "../../components/GenresOverviewGrid.tsx";
import EverythingSection from "../../components/EverythingSection.tsx";
import Footer from "../../components/Footer.astro";
---

<Layout title="Publishing Genres & Categories — Hearst Book Studio">
  <div class="relative bg-black text-white">
    <Navbar client:load />

    {/* SECTION 1: Genre Hub Hero */}
    <section 
      class="relative min-h-[60vh] flex items-center justify-center pt-28 pb-16 px-4 sm:px-6 bg-cover bg-center bg-no-repeat overflow-hidden border-b border-white/10"
      style="background-image: url('/images/genre/fiction/section-1.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/60 to-black/90 pointer-events-none"></div>

      <div class="relative z-10 max-w-5xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-[#3075ba]/30 border border-[#3075ba]/60 px-4 py-1.5 mb-6">
          <span class="w-2.5 h-2.5 bg-[#3075ba] rounded-full animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-widest text-white">
            HEARST BOOK STUDIO PUBLISHING DEPARTMENTS
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-7xl font-extrabold uppercase tracking-tight text-white leading-tight mb-6 drop-shadow-2xl">
          EXPLORE OUR <span class="text-[#3075ba]">PUBLISHING GENRES</span>
        </h1>

        <p class="text-sm sm:text-base md:text-lg text-gray-100 font-medium max-w-3xl mx-auto leading-relaxed mb-8 drop-shadow-md">
          From fiction sagas and illustrated children's books to executive business playbooks, memoirs, and sacred texts, explore our dedicated genre publishing studios.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-bold text-gray-300 uppercase tracking-widest bg-black/60 p-4 border border-white/15 max-w-3xl mx-auto">
          <span>📚 10 Dedicated Studios</span>
          <span class="text-[#3075ba]">•</span>
          <span>✍️ Ghostwriting & Editing</span>
          <span class="text-[#3075ba]">•</span>
          <span>🌍 Global Retail Distribution</span>
        </div>
      </div>
    </section>

    {/* SECTION 2: Genres Grid Section */}
    <section class="relative py-16 sm:py-24 px-4 sm:px-6 bg-slate-950/90">
      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
          <span class="text-xs font-bold uppercase tracking-widest text-[#3075ba] block mb-2">
            SPECIALIZED PUBLISHING STUDIOS
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold uppercase tracking-tight text-white">
            CHOOSE YOUR GENRE DEPARTMENTS
          </h2>
          <p class="text-xs sm:text-sm text-gray-200 mt-3 font-medium">
            Select a genre below to explore tailored publishing services, cover designs, editorial pipelines, and featured book showcases.
          </p>
        </div>

        <GenresOverviewGrid client:load />
      </div>
    </section>

    <EverythingSection client:load />
    <Footer />
  </div>
</Layout>
