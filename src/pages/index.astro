---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.tsx";
import Hero from "../components/Hero.astro";
import BrandsSection from "../components/BrandsSection.astro";
import AboutSection from "../components/AboutSection.astro";
import BooksSection from "../components/BooksSection.tsx";
import ConcernsSection from "../components/ConcernsSection.astro";
import ServicesSection from "../components/ServicesSection.astro";
import SuccessStoriesSection from "../components/SuccessStoriesSection.tsx";
import HowWeWork from "../components/HowWeWork.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import EverythingSection from "../components/EverythingSection.tsx";
import Footer from "../components/Footer.astro";
---

<Layout title="HearEst Book Studio">
  <div class="relative">
    <Navbar client:load />
    <Hero />
  </div>
  <BrandsSection />
  <AboutSection />
  <BooksSection client:load />
  <ConcernsSection />
  <ServicesSection />
  <SuccessStoriesSection client:load />
  <HowWeWork />
  <WhyChooseUs />
  <EverythingSection client:load />
  <Footer />
</Layout>
