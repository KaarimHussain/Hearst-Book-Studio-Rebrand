---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.tsx";
import InnerPageHero from "../components/InnerPageHero.astro";
import ScrollReveal from "../components/ui/ScrollReveal.tsx";
import BrandsSection from "../components/BrandsSection.astro";
import PackagesSection from "../components/PackagesSection.tsx";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import EverythingSection from "../components/EverythingSection.tsx";
import Footer from "../components/Footer.astro";
---

<Layout title="Packages — Hearst Book Studio">
  <div class="relative">
    <Navbar client:load />
    <InnerPageHero 
      bgImg="/images/Rectangle%202%20(1).png"
      heading="WANT TO PUBLISH YOUR BOOK AT AN AFFORDABLE PRICE?"
      subtext="Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since 1966."
    />
  </div>

  <section class="py-10 sm:py-14 bg-white">
    <ScrollReveal client:visible direction="up" className="max-w-7xl mx-auto px-4 sm:px-6">
      <p class="text-[#555] text-xs sm:text-sm font-medium leading-relaxed max-w-5xl">
        Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since 1966, when designers at Letraset and James Mosley, the librarian at St Bride Printing Library in London, took a 1914 Cicero translation.
      </p>
    </ScrollReveal>
  </section>

  <BrandsSection />
  
  <PackagesSection client:visible />

  <WhyChooseUs
    bgImg="/images/c77ab02d-b5e9-4632-8e67-321380a8d826.webp"
    bookImg="/images/fb851f5d-5fd0-44ba-8b86-7f36f9eb37d7.webp"
  />

  <EverythingSection client:load />
  
  <Footer />
</Layout>
